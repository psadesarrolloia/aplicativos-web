<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/PsaWeb.Shared/css/psa-theme.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PsaWeb.Host.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="@RenderMode" />
</head>

<body>
    <Routes @rendermode="@RenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Estático (null) para las pantallas del shell marcadas con
    // [ExcludeFromInteractiveRouting] (login por cookie); interactivo para el resto.
    private IComponentRenderMode? RenderMode =>
        HttpContext.AceptaRuteoInteractivo() ? InteractiveServer : null;
}
