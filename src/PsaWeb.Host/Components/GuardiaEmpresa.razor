@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using PsaWeb.Seguridad
@inject EmpresaActualService EmpresaActual
@inject ISecurityDirectory Seguridad
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ProtectedLocalStorage LocalStorage
@implements IDisposable

@* Sin UI. Si hay usuario autenticado y todavía no eligió empresa, intenta
   rehidratar la última selección; si no puede, manda a /seleccionar-empresa. *@

@code {
    protected override void OnInitialized() => EmpresaActual.Cambio += Refrescar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || EmpresaActual.HaySeleccion) return;

        var state = await AuthState.GetAuthenticationStateAsync();
        var usuario = state.User.Identity?.Name;
        if (string.IsNullOrEmpty(usuario)) return;

        var path = new Uri(Nav.Uri).AbsolutePath;
        if (EsRutaLibre(path)) return;

        // Intento rehidratar la última empresa elegida (y revalidar acceso).
        try
        {
            var guardado = await LocalStorage.GetAsync<EmpresaGuardada>("psa.empresa");
            if (guardado.Success && guardado.Value is { } g)
            {
                var empresas = await Seguridad.EmpresasDelUsuarioAsync(usuario);
                var emp = empresas.FirstOrDefault(e => e.Ruc == g.Ruc);
                if (emp is not null)
                {
                    EmpresaActual.Fijar(emp, g.Ambiente);
                    return;
                }
            }
        }
        catch
        {
            // storage no disponible: seguimos al selector
        }

        Nav.NavigateTo("/seleccionar-empresa");
    }

    private static bool EsRutaLibre(string path) =>
        path.StartsWith("/seleccionar-empresa", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/salir", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/mi-cuenta", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/bienvenida", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/ingresar", StringComparison.OrdinalIgnoreCase);

    private void Refrescar() => InvokeAsync(StateHasChanged);

    public void Dispose() => EmpresaActual.Cambio -= Refrescar;
}
