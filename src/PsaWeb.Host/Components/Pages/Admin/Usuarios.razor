@page "/admin/usuarios"
@using System.ComponentModel.DataAnnotations
@using PsaWeb.Identidad
@using PsaWeb.Seguridad
@inject ServicioAccesos Accesos
@inject NavigationManager Nav

<PageTitle>Usuarios — Aplicativos Web PSA</PageTitle>

<AdminMarco Requiere="RolPanel.SuperAdmin" AlCargar="AlCargar"
            Subtitulo="Cuentas personales de la plataforma web (solo Super Admin). Las empresas y módulos de cada una se asignan en «Accesos».">
    <PsaCard Title="Nueva cuenta">
        <p class="psa-muted">La cuenta se crea <strong>sin contraseña</strong>: a la persona le llega un enlace a su correo para definirla (vale 24 h).</p>
        <EditForm Model="_nuevo" OnValidSubmit="Crear">
            <DataAnnotationsValidator />
            <div class="psa-row" style="align-items:flex-end;flex-wrap:wrap;margin-top:.6rem">
                <label class="psa-field"><span class="psa-field__lbl">Nombre y apellido</span>
                    <InputText class="psa-input" @bind-Value="_nuevo.Nombre" /></label>
                <label class="psa-field"><span class="psa-field__lbl">Correo (con el que ingresa)</span>
                    <InputText class="psa-input" @bind-Value="_nuevo.Email" inputmode="email" /></label>
                <label class="psa-field"><span class="psa-field__lbl">Usuario interno (no cambia nunca)</span>
                    <InputText class="psa-input" @bind-Value="_nuevo.Usuario" placeholder="p. ej. kpaucar" /></label>
                <label class="psa-field"><span class="psa-field__lbl">Acceso al panel</span>
                    <InputSelect class="psa-input" @bind-Value="_nuevo.Perfil">
                        @foreach (var p in Perfiles.Todos)
                        {
                            <option value="@p">@Perfiles.Etiqueta(p)</option>
                        }
                    </InputSelect></label>
                <label class="psa-field"><span class="psa-field__lbl">Copiar accesos del .exe (usuario PeachEBills, opcional)</span>
                    <InputText class="psa-input" @bind-Value="_nuevo.PeachUsername" placeholder="p. ej. peachb2019" /></label>
                <PsaButton Variant="primary" Type="submit" Disabled="_ocupado">Crear y enviar invitación</PsaButton>
            </div>
            <ValidationSummary />
        </EditForm>
        @if (_msgCrear is not null)
        {
            <p class="psa-notice @(_crearOk ? "" : "psa-notice--danger")" style="margin-top:.6rem">@_msgCrear</p>
        }
    </PsaCard>

    @if (_filas is null)
    {
        <p class="psa-muted">Cargando…</p>
    }
    else
    {
        <PsaCard Title="@($"{_filas.Count} cuentas")">
            @if (_filas.Any(f => f.Activo && !f.TieneClave && f.Email is not null))
            {
                <div class="psa-row" style="margin-bottom:.6rem;align-items:center">
                    <span class="psa-muted">@_filas.Count(f => f.Activo && !f.TieneClave && f.Email is not null) cuenta(s) todavía sin clave.</span>
                    <PsaButton Variant="secondary" OnClick="InvitarPendientes" Disabled="_ocupado">Enviar invitaciones pendientes</PsaButton>
                </div>
            }
            @if (_msg is not null)
            {
                <p class="psa-notice @(_msgOk ? "" : "psa-notice--danger")" style="margin-bottom:.6rem">@_msg</p>
            }
            <div style="overflow-x:auto">
            <table class="psa-table">
                <thead>
                    <tr>
                        <th>Usuario</th><th>Nombre</th><th>Correo</th><th title="Acceso al panel de administración">Panel</th><th title="Deducido de sus módulos">Nivel</th><th class="num">Empresas</th>
                        <th>2FA</th><th>Último acceso</th><th>Estado</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _filas)
                    {
                        var propia = f.Id == Actor?.Id;
                        <tr>
                            <td>@f.UserName</td>
                            <td>@f.Nombre</td>
                            <td>
                                @(f.Email ?? "—")
                                @if (f.Email is not null && !f.EmailConfirmado)
                                {
                                    <span class="psa-muted" title="Todavía no definió su clave desde el enlace"> (sin confirmar)</span>
                                }
                            </td>
                            <td>
                                @if (propia || f.PerfilEfectivo != f.Perfil)
                                {
                                    @Perfiles.Etiqueta(f.PerfilEfectivo)
                                    @if (f.PerfilEfectivo != f.Perfil)
                                    {
                                        <span class="psa-muted" title="Está en Plataforma:Admins del web.config (respaldo de emergencia)"> (web.config)</span>
                                    }
                                }
                                else
                                {
                                    <select class="psa-input" value="@f.Perfil" @onchange="e => CambiarPerfil(f, e.Value?.ToString())">
                                        @foreach (var p in Perfiles.Todos)
                                        {
                                            <option value="@p">@Perfiles.Etiqueta(p)</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td>@f.Nivel</td>
                            <td class="num">@f.Empresas</td>
                            <td>
                                @(f.DosFactores ? (f.Metodo == MetodosSegundoFactor.Correo ? "correo" : "app") : "no")
                                @if (!f.DosFactores && Perfiles.ExigeSegundoFactor(f.PerfilEfectivo))
                                {
                                    <span class="psa-muted"> (obligatorio, pendiente)</span>
                                }
                            </td>
                            <td>@(f.UltimoAccesoUtc?.AddHours(-5).ToString("dd/MM/yyyy HH:mm") ?? "nunca")</td>
                            <td>@(f.Activo ? "activa" : "deshabilitada")</td>
                            <td style="white-space:nowrap">
                                <a class="psa-linkbtn" href="@($"/admin/accesos/{f.Id}")">Accesos</a>
                                <button type="button" class="psa-linkbtn" @onclick="() => Invitar(f)" disabled="@(f.Email is null)"
                                        title="Manda un enlace para definir la contraseña (sirve también para resetearla)">
                                    @(f.TieneClave ? "Enviar enlace de clave" : "Reenviar invitación")
                                </button>
                                <button type="button" class="psa-linkbtn" @onclick="() => AbrirEdicion(f)">Correo / clave</button>
                                @if (!propia)
                                {
                                    <button type="button" class="psa-linkbtn" @onclick="() => AlternarActivo(f)">@(f.Activo ? "Deshabilitar" : "Habilitar")</button>
                                }
                                @if (f.DosFactores)
                                {
                                    <button type="button" class="psa-linkbtn" @onclick="() => QuitarDosFactores(f)">Quitar 2FA</button>
                                }
                            </td>
                        </tr>
                        @if (_editando == f.Id)
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="psa-row" style="align-items:flex-end;flex-wrap:wrap">
                                        <label class="psa-field"><span class="psa-field__lbl">Correo</span>
                                            <input class="psa-input" @bind="_editCorreo" /></label>
                                        <PsaButton Variant="secondary" OnClick="() => GuardarCorreo(f)">Guardar correo</PsaButton>
                                        <label class="psa-field"><span class="psa-field__lbl">Clave temporal (si el correo no llega)</span>
                                            <input type="password" class="psa-input" @bind="_editClave" autocomplete="new-password" /></label>
                                        <PsaButton Variant="secondary" OnClick="() => PonerClave(f)">Poner clave</PsaButton>
                                        <PsaButton Variant="ghost" OnClick="() => _editando = null">Cerrar</PsaButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        </PsaCard>
    }
</AdminMarco>

@code {
    private ServicioAccesos.Actor? Actor;

    private List<UsuarioPanel>? _filas;
    private readonly DatosNuevo _nuevo = new();
    private string? _msgCrear;
    private bool _crearOk;
    private bool _ocupado;
    private string? _msg;
    private bool _msgOk;

    private string? _editando;
    private string _editCorreo = "";
    private string _editClave = "";

    private async Task AlCargar(ServicioAccesos.Actor actor)
    {
        Actor = actor;
        await CargarAsync();
    }

    private async Task CargarAsync() => _filas = (await Accesos.UsuariosAsync()).ToList();

    private void Aviso(string texto, bool ok) { _msg = texto; _msgOk = ok; }

    private async Task Ejecutar(Func<Task> accion, string ok)
    {
        try
        {
            await accion();
            Aviso(ok, true);
        }
        catch (Exception ex) when (ex is AccesoDenegadoException or InvalidOperationException)
        {
            Aviso(ex.Message, false);
        }
        await CargarAsync();
    }

    private async Task Crear()
    {
        _msgCrear = null;
        _ocupado = true;
        try
        {
            var u = await Accesos.CrearUsuarioAsync(Actor!, _nuevo.Usuario, _nuevo.Nombre, _nuevo.Email, _nuevo.Perfil, null);
            var partes = new List<string> { $"Cuenta «{u.UserName}» creada." };
            if (!string.IsNullOrWhiteSpace(_nuevo.PeachUsername))
            {
                var n = await Accesos.ImportarDesdePeachEbillsAsync(Actor!, u.Id, _nuevo.PeachUsername.Trim());
                partes.Add($"Se copiaron los accesos del .exe de {n} empresa(s); revísalos en «Accesos».");
            }
            if (Accesos.CorreoDisponible)
            {
                await Accesos.EnviarInvitacionAsync(Actor!, u.Id, Nav.BaseUri);
                partes.Add($"Invitación enviada a {u.Email}.");
            }
            else
            {
                partes.Add("El correo saliente no está configurado: pon una clave temporal desde «Correo / clave».");
            }
            _crearOk = true;
            _msgCrear = string.Join(" ", partes);
            _nuevo.Usuario = _nuevo.Nombre = _nuevo.Email = _nuevo.PeachUsername = "";
            _nuevo.Perfil = Perfiles.Usuario;
            await CargarAsync();
        }
        catch (Exception ex) when (ex is AccesoDenegadoException or InvalidOperationException)
        {
            _crearOk = false;
            _msgCrear = ex.Message;
        }
        catch (Exception)
        {
            _crearOk = false;
            _msgCrear = "La cuenta se creó pero no se pudo enviar la invitación (revisa el correo saliente). Reintenta con «Reenviar invitación».";
            await CargarAsync();
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Invitar(UsuarioPanel f)
    {
        try
        {
            await Accesos.EnviarInvitacionAsync(Actor!, f.Id, Nav.BaseUri);
            Aviso($"Enlace enviado a {f.Email}.", true);
        }
        catch (AccesoDenegadoException ex) { Aviso(ex.Message, false); }
        catch (Exception) { Aviso("No se pudo enviar el correo. Revisa el correo saliente o pon una clave temporal.", false); }
    }

    private async Task InvitarPendientes()
    {
        _ocupado = true;
        try
        {
            var (n, errores) = await Accesos.EnviarInvitacionesPendientesAsync(Actor!, Nav.BaseUri);
            Aviso(errores.Count == 0 ? $"Invitaciones enviadas: {n}." : $"Invitaciones enviadas: {n}. Fallaron: {string.Join(" · ", errores)}", errores.Count == 0);
        }
        catch (AccesoDenegadoException ex) { Aviso(ex.Message, false); }
        finally { _ocupado = false; }
        await CargarAsync();
    }

    private Task CambiarPerfil(UsuarioPanel f, string? perfil) =>
        Ejecutar(() => Accesos.CambiarPerfilAsync(Actor!, f.Id, perfil ?? ""), $"Perfil de {f.UserName} actualizado.");

    private void AbrirEdicion(UsuarioPanel f)
    {
        _editando = f.Id;
        _editCorreo = f.Email ?? "";
        _editClave = "";
    }

    private Task GuardarCorreo(UsuarioPanel f) =>
        Ejecutar(() => Accesos.CambiarCorreoAsync(Actor!, f.Id, _editCorreo), $"Correo de {f.UserName} actualizado (queda sin confirmar hasta que use un enlace).");

    private async Task PonerClave(UsuarioPanel f)
    {
        try
        {
            var error = await Accesos.PonerClaveTemporalAsync(Actor!, f.Id, _editClave);
            if (error is not null)
            {
                Aviso(error, false);
                return;
            }
        }
        catch (Exception ex) when (ex is AccesoDenegadoException or InvalidOperationException)
        {
            Aviso(ex.Message, false);
            return;
        }
        _editClave = "";
        _editando = null;
        Aviso($"Clave temporal puesta a {f.UserName}. Pásasela por un canal seguro y pídele que la cambie desde «¿Olvidaste tu contraseña?».", true);
        await CargarAsync();
    }

    private Task AlternarActivo(UsuarioPanel f) =>
        Ejecutar(() => Accesos.CambiarActivoAsync(Actor!, f.Id, !f.Activo), f.Activo ? $"{f.UserName} deshabilitada." : $"{f.UserName} habilitada.");

    private Task QuitarDosFactores(UsuarioPanel f) =>
        Ejecutar(() => Accesos.QuitarSegundoFactorAsync(Actor!, f.Id), $"Se quitó la verificación en dos pasos de {f.UserName}.");

    public sealed class DatosNuevo
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "El correo es obligatorio.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "El usuario interno es obligatorio.")]
        public string Usuario { get; set; } = "";

        public string Perfil { get; set; } = Perfiles.Usuario;
        public string PeachUsername { get; set; } = "";
    }
}
