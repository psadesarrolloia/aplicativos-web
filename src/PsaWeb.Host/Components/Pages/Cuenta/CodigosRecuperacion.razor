<div class="psa-notice" style="margin-top:1rem">
    <strong>Guardá estos códigos de recuperación</strong> en un lugar seguro. Cada uno sirve una sola vez
    si perdés acceso a la app de autenticación. No se vuelven a mostrar.
</div>
<ul class="psa-codigos">
    @foreach (var c in Codigos)
    {
        <li><code>@c</code></li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Codigos { get; set; } = Array.Empty<string>();
}
