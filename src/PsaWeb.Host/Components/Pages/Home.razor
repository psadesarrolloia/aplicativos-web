@page "/"
@using PsaWeb.Seguridad
@inject ISecurityDirectory Seguridad
@inject EmpresaActualService EmpresaActual
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<PageTitle>Inicio — Aplicativos web PSA</PageTitle>

@if (!EmpresaActual.HaySeleccion)
{
    <p class="psa-muted">Cargando…</p>
}
else
{
    <PsaPageHeader Title="Inicio"
                   Subtitle="@($"Empresa: {EmpresaActual.Nombre} · Ambiente: {(EmpresaActual.Ambiente == Ambiente.Pruebas ? "Pruebas" : "Producción")}")" />

    @if (_apps.Count == 0)
    {
        <PsaCard Title="Sin aplicativos habilitados">
            <p class="psa-muted">
                Tu usuario no tiene permisos para ningún aplicativo en esta empresa. Contactá al administrador.
            </p>
        </PsaCard>
    }
    else
    {
        <div class="psa-grid psa-grid--cards">
            @foreach (var app in _apps)
            {
                <a class="psa-app-card" href="@app.Ruta">
                    <span class="psa-app-card__icon">@app.Icono</span>
                    <span class="psa-app-card__nombre">@app.Nombre</span>
                    <span class="psa-app-card__desc">@app.Descripcion</span>
                </a>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<AppWeb> _apps = Array.Empty<AppWeb>();

    protected override void OnInitialized() => EmpresaActual.Cambio += AlCambiar;

    protected override async Task OnInitializedAsync() => await CargarApps();

    private async void AlCambiar()
    {
        await CargarApps();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarApps()
    {
        if (!EmpresaActual.HaySeleccion) { _apps = Array.Empty<AppWeb>(); return; }

        var state = await AuthState.GetAuthenticationStateAsync();
        var usuario = state.User.Identity?.Name ?? "";
        var ctx = await Seguridad.ContextoAsync(usuario, EmpresaActual.Ruc!);
        _apps = AppCatalogo.Habilitadas(ctx).ToList();
    }

    public void Dispose() => EmpresaActual.Cambio -= AlCambiar;
}
