@inherits LayoutComponentBase

<div class="psa-shell">
    <header class="psa-topbar">
        <a class="psa-brand" href="/">
            <img src="_content/PsaWeb.Shared/img/psa-logo-white.png" alt="PSA" />
            <span>Aplicativos web</span>
        </a>
        <NavMenu />
        <div class="psa-user">
            <AuthorizeView>
                <Authorized>
                    <EmpresaSwitcher />
                    <a class="psa-user__link" href="/mi-cuenta/seguridad">@context.User.Identity?.Name</a>
                    <a class="psa-user__salir" href="/salir">Salir</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <GuardiaEmpresa />

    <main class="psa-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
