@using Microsoft.Extensions.Options
@using PsaWeb.Identidad
@using PsaWeb.Seguridad
@inject ISecurityDirectory Seguridad
@inject EmpresaActualService EmpresaActual
@inject AuthenticationStateProvider AuthState
@inject IOptions<PlataformaOptions> Plataforma
@implements IDisposable

<nav class="psa-nav">
    <NavLink class="psa-nav__link" href="/" Match="NavLinkMatch.All">Inicio</NavLink>
    @foreach (var app in _apps)
    {
        <NavLink class="psa-nav__link" href="@app.Ruta">@app.Nombre</NavLink>
    }
    @if (_esAdmin)
    {
        <NavLink class="psa-nav__link" href="/admin/usuarios">Administración</NavLink>
    }
</nav>

@code {
    private IReadOnlyList<AppWeb> _apps = Array.Empty<AppWeb>();
    private bool _esAdmin;

    protected override void OnInitialized() => EmpresaActual.Cambio += AlCambiar;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _esAdmin = Plataforma.Value.EsAdmin(state.User.Identity?.Name);
        await CargarAsync();
    }

    private async void AlCambiar()
    {
        await CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarAsync()
    {
        if (!EmpresaActual.HaySeleccion)
        {
            _apps = Array.Empty<AppWeb>();
            return;
        }

        var state = await AuthState.GetAuthenticationStateAsync();
        var usuario = state.User.Identity?.Name ?? "";
        var ctx = await Seguridad.ContextoAsync(usuario, EmpresaActual.Ruc!);
        _apps = AppCatalogo.Habilitadas(ctx).ToList();
    }

    public void Dispose() => EmpresaActual.Cambio -= AlCambiar;
}
