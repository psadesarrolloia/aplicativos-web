@using Microsoft.Extensions.Options
@using PsaWeb.Identidad
@using PsaWeb.Seguridad
@inject ISecurityDirectory Seguridad
@inject EmpresaActualService EmpresaActual
@inject AuthenticationStateProvider AuthState
@inject IServiceProvider Servicios
@inject IOptions<EscrituraOptions> Escritura
@inject NavigationManager Nav
@implements IDisposable

<nav class="psa-nav">
    <NavLink class="psa-nav__link" href="/" Match="NavLinkMatch.All">Inicio</NavLink>

    @foreach (var categoria in Categorias.Orden)
    {
        var modulos = _apps.Where(a => a.Categoria == categoria).ToList();
        if (modulos.Count == 0)
        {
            continue;
        }

        <div class="psa-navgroup">
            <button type="button"
                    class="psa-nav__link psa-navgroup__btn @(EsCategoriaActiva(modulos) ? "active" : null)"
                    @onclick="() => Alternar(categoria)">
                @categoria <span class="psa-navgroup__caret">▾</span>
            </button>

            @if (_categoriaAbierta == categoria)
            {
                <div class="psa-navgroup__backdrop" @onclick="Cerrar"></div>
                <div class="psa-navgroup__panel">
                    @foreach (var modulo in modulos)
                    {
                        <NavLink class="psa-navgroup__item" href="@modulo.Ruta">
                            <span class="psa-navgroup__icon">@modulo.Icono</span>
                            <span>@modulo.Nombre</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    @if (_rol != RolPanel.Ninguno)
    {
        // Menú de configuración (solo administradores): mismas páginas que la subnavegación de /admin.
        <div class="psa-navgroup">
            <button type="button"
                    class="psa-nav__link psa-navgroup__btn @(EsAdminActivo ? "active" : null)"
                    @onclick="() => Alternar(MenuConfiguracion)">
                @MenuConfiguracion <span class="psa-navgroup__caret">▾</span>
            </button>

            @if (_categoriaAbierta == MenuConfiguracion)
            {
                <div class="psa-navgroup__backdrop" @onclick="Cerrar"></div>
                <div class="psa-navgroup__panel">
                    @if (_rol == RolPanel.SuperAdmin)
                    {
                        <NavLink class="psa-navgroup__item" href="/admin/usuarios">
                            <span class="psa-navgroup__icon">👤</span><span>Usuarios</span>
                        </NavLink>
                    }
                    <NavLink class="psa-navgroup__item" href="/admin/accesos" Match="NavLinkMatch.Prefix">
                        <span class="psa-navgroup__icon">🔐</span><span>Accesos (empresas y módulos)</span>
                    </NavLink>
                    <NavLink class="psa-navgroup__item" href="/admin/auditoria">
                        <span class="psa-navgroup__icon">📜</span><span>Auditoría</span>
                    </NavLink>
                    @if (_rol == RolPanel.SuperAdmin && Escritura.Value.Habilitada)
                    {
                        <NavLink class="psa-navgroup__item" href="/admin/sage-bridge">
                            <span class="psa-navgroup__icon">🔌</span><span>Sage Bridge (empresas y cola)</span>
                        </NavLink>
                    }
                    @if (_rol == RolPanel.SuperAdmin)
                    {
                        <NavLink class="psa-navgroup__item" href="/admin/ventas">
                            <span class="psa-navgroup__icon">🧾</span><span>Ventas (prefacturas)</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }
</nav>

@code {
    private IReadOnlyList<AppWeb> _apps = Array.Empty<AppWeb>();
    private RolPanel _rol;
    private string? _categoriaAbierta;

    protected override void OnInitialized()
    {
        EmpresaActual.Cambio += AlCambiar;
        Nav.LocationChanged += AlNavegar;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _rol = await PsaWeb.Host.Auth.RolesPanel.RolAsync(Servicios, state.User.Identity?.Name);
        await CargarAsync();
    }

    private async void AlCambiar()
    {
        await CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void AlNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _categoriaAbierta = null;
        InvokeAsync(StateHasChanged);
    }

    private async Task CargarAsync()
    {
        if (!EmpresaActual.HaySeleccion)
        {
            _apps = Array.Empty<AppWeb>();
            return;
        }

        var state = await AuthState.GetAuthenticationStateAsync();
        var usuario = state.User.Identity?.Name ?? "";
        var ctx = await Seguridad.ContextoAsync(usuario, EmpresaActual.Ruc!);
        _apps = AppCatalogo.Habilitadas(ctx, Escritura.Value.Habilitada).ToList();
    }

    private void Alternar(string categoria) =>
        _categoriaAbierta = _categoriaAbierta == categoria ? null : categoria;

    private void Cerrar() => _categoriaAbierta = null;

    private const string MenuConfiguracion = "Configuración";

    private bool EsAdminActivo => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);

    private bool EsCategoriaActiva(IEnumerable<AppWeb> modulos)
    {
        var ruta = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return modulos.Any(m => ruta == m.Ruta || ruta.StartsWith(m.Ruta + "/", StringComparison.Ordinal));
    }

    public void Dispose()
    {
        EmpresaActual.Cambio -= AlCambiar;
        Nav.LocationChanged -= AlNavegar;
    }
}
