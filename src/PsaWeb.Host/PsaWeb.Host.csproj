<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- El driver Pervasive ODBC de Sage 50 es de 32 bits: el Host debe correr como x86. -->
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>PsaWeb.Host</RootNamespace>
    <!-- Permite `dotnet user-secrets set "Sage50:ConnectionString" "..."` sin `init` previo.
         Los secretos NO se guardan en git: van a %APPDATA%\Microsoft\UserSecrets. -->
    <UserSecretsId>psaweb-host-9f2c4e1a-cierre-de-caja</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsaWeb.Shared\PsaWeb.Shared.csproj" />
    <ProjectReference Include="..\PsaWeb.Sage50\PsaWeb.Sage50.csproj" />
    <ProjectReference Include="..\PsaWeb.PeachEbills\PsaWeb.PeachEbills.csproj" />
    <ProjectReference Include="..\PsaWeb.Datil\PsaWeb.Datil.csproj" />
    <ProjectReference Include="..\..\modules\PsaWeb.Modules.CierreDeCaja\PsaWeb.Modules.CierreDeCaja.csproj" />
    <ProjectReference Include="..\..\modules\PsaWeb.Modules.Retenciones\PsaWeb.Modules.Retenciones.csproj" />
    <ProjectReference Include="..\PsaWeb.Seguridad\PsaWeb.Seguridad.csproj" />
  </ItemGroup>

  <!-- Antes de compilar, cierra cualquier instancia colgada del Host de una sesión
       anterior de Visual Studio. Evita el error MSB3021/MSB3026 "no se puede copiar
       PsaWeb.Host.exe: en uso por otro proceso". Solo Windows; nunca falla la build. -->
  <Target Name="KillStaleHost" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /F /IM $(AssemblyName).exe /T 2&gt;nul" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

</Project>
