<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lógica pura del portal de ventas (docs/PLAN-PORTAL-VENTAS.md): prefactura, cálculo con el redondeo de Sage, validaciones,
       PDF (QuestPDF, igual que el Talón del ATS) y cuerpo del correo. Sin ODBC ni EF. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PsaWeb.Ventas.Tests" />
  </ItemGroup>

</Project>
