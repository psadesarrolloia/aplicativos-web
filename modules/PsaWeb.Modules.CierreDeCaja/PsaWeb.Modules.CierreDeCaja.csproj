<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Módulo de Blazor Server: usa ODBC (System.Data.Odbc), nunca corre en navegador.
         Sin esto, CA1416 marca cada llamada ODBC como "no soportada en browser". -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PsaWeb.Shared\PsaWeb.Shared.csproj" />
    <ProjectReference Include="..\..\src\PsaWeb.Sage50\PsaWeb.Sage50.csproj" />
  </ItemGroup>

</Project>
