@page "/cierre-de-caja"
@namespace PsaWeb.Modules.CierreDeCaja.Pages

<PageTitle>Cierre de Caja — Aplicativos web PSA</PageTitle>

<PsaPageHeader Title="Cierre de Caja"
               Subtitle="Compara los cobros contra las ventas registradas en Sage 50 para un rango de fechas." />

<PsaCard Title="Parámetros">
    <PsaDateRange From="_from" To="_to"
                  FromChanged="v => _from = v" ToChanged="v => _to = v" />
    <div class="psa-row" style="margin-top: 1.1rem">
        <PsaButton Variant="primary" OnClick="Consultar">Consultar</PsaButton>
        <PsaButton Variant="secondary" Disabled="true">Exportar a Excel</PsaButton>
    </div>
</PsaCard>

@if (_consulted)
{
    <PsaCard Title="Resultado">
        <p class="psa-notice">
            La conexión a Sage 50 se cablea en la <strong>Fase 2</strong>. La estructura de la
            pantalla —rango de fechas, detalle de cobros y totales— ya está lista; falta enganchar
            el repositorio ODBC (<code>ISageConnectionFactory</code> ya está registrado).
        </p>

        <p class="psa-muted" style="margin-top: 1rem">
            Rango seleccionado: <strong>@_from.ToString("dd/MM/yyyy")</strong>
            a <strong>@_to.ToString("dd/MM/yyyy")</strong>
        </p>

        <div class="psa-grid psa-grid--stats" style="margin-top: 1rem">
            <PsaStat Label="Total ventas" Value="—" />
            <PsaStat Label="Total cobros" Value="—" />
            <PsaStat Label="Diferencia" Value="—" />
        </div>
    </PsaCard>
}

@code {
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);
    private bool _consulted;

    private void Consultar() => _consulted = true;
}
