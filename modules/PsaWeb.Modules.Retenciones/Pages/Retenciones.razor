@page "/retenciones"
@namespace PsaWeb.Modules.Retenciones.Pages
@using System.Globalization
@using PsaWeb.Datil
@using PsaWeb.Modules.Retenciones
@using PsaWeb.Modules.Retenciones.Data
@using PsaWeb.Seguridad
@inject IServiceProvider Sp
@inject ILogger<Retenciones> Logger
@inject AuthenticationStateProvider AuthState

<PageTitle>Retenciones — Aplicativos web PSA</PageTitle>

<PsaPageHeader Title="Retenciones"
               Subtitle="Genera las retenciones de compra pendientes en Sage 50 y las emite en Datil." />

@if (_tablero is null || _procesador is null)
{
    <PsaCard Title="Módulo no configurado">
        <p class="psa-notice psa-notice--danger">
            Falta la cadena de conexión <code>PeachEbills:ConnectionString</code>. Configúrala en el Host
            (User Secrets en desarrollo, variable de entorno en el servidor) y reinicia la aplicación.
        </p>
    </PsaCard>
}
else
{
    <PsaCard Title="Modo de emisión">
        @if (_dryRun)
        {
            <p class="psa-notice">
                <strong>DRY-RUN activo.</strong> Se arma y valida cada retención pero <strong>no</strong> se envía a
                Datil ni se guarda nada. Para emitir de verdad: <code>Datil:DryRun=false</code> en el Host.
            </p>
        }
        else
        {
            <p class="psa-notice psa-notice--danger">
                <strong>EMISIÓN REAL.</strong> «Ejecutar ahora» enviará las retenciones a Datil (autoriza ante el SRI,
                es irreversible) y las guardará en PeachEBills.
            </p>
        }
        @if (_ambienteForzado is { } amb)
        {
            <p class="psa-muted" style="margin-top:.5rem">
                Ambiente forzado por configuración: <strong>@AmbienteTexto(amb)</strong>.
            </p>
        }
    </PsaCard>

    <PsaCard Title="@(EnfocadoEnMiEmpresa ? "Mi empresa" : "Empresas activas")">
        <Actions>
            @if (_puedeTodas)
            {
                <PsaButton Variant="ghost" OnClick="AlternarAlcance" Disabled="_cargando || _ejecutando">
                    @(_verTodas ? "Ver solo mi empresa" : "Ver todas las empresas")
                </PsaButton>
            }
            <PsaButton Variant="secondary" OnClick="CargarPanorama" Disabled="_cargando || _ejecutando">
                @(_cargando ? "Actualizando…" : "Actualizar")
            </PsaButton>
            <PsaButton Variant="primary" OnClick="EjecutarAhora" Disabled="_cargando || _ejecutando">
                @(_ejecutando ? "Ejecutando…"
                    : EnfocadoEnMiEmpresa ? "Ejecutar (mi empresa)" : "Ejecutar todas")
            </PsaButton>
        </Actions>
        <ChildContent>

        @if (_avisoCorrida is not null)
        {
            <p class="psa-notice">@_avisoCorrida</p>
        }
        @if (_errorPanorama is not null)
        {
            <p class="psa-notice psa-notice--danger">@_errorPanorama</p>
        }
        else if (_panorama is null)
        {
            <p class="psa-muted">Cargando…</p>
        }
        else if (_panorama.Count == 0)
        {
            <p class="psa-notice">No hay empresas activas.</p>
        }
        else
        {
            var vista = FilasVista();

            <div class="psa-grid psa-grid--stats" style="margin-bottom:1rem">
                <PsaStat Label="Empresas" Value="@($"{vista.Count} / {_panorama.Count}")" />
                <PsaStat Label="Retenciones pendientes" Value="@vista.Sum(f => f.Pendientes).ToString()"
                         State="@(vista.Sum(f => f.Pendientes) > 0 ? "warn" : "ok")" />
            </div>

            <p class="psa-muted" style="margin-bottom:.4rem">
                Clic en el encabezado para ordenar · clic en una fila para ver sus retenciones guardadas.
                @if (TieneFiltros)
                {
                    <button type="button" class="psa-linkbtn" @onclick="LimpiarFiltros">Limpiar filtros</button>
                }
            </p>

            <div style="overflow-x:auto">
            <table class="psa-table psa-table--interactiva">
                <thead>
                    <tr>
                        <th class="sortable" @onclick="@(() => Ordenar(Col.Ruc))">RUC @Flecha(Col.Ruc)</th>
                        <th class="sortable" @onclick="@(() => Ordenar(Col.Empresa))">Empresa @Flecha(Col.Empresa)</th>
                        <th class="sortable" @onclick="@(() => Ordenar(Col.Ambiente))">Ambiente @Flecha(Col.Ambiente)</th>
                        <th class="sortable num" @onclick="@(() => Ordenar(Col.Pendientes))">Pendientes @Flecha(Col.Pendientes)</th>
                        <th class="sortable" @onclick="@(() => Ordenar(Col.UltimaEmision))">Última emisión @Flecha(Col.UltimaEmision)</th>
                    </tr>
                    <tr class="psa-table__filtros">
                        <th><input class="@ClaseFiltro(_fRuc)" placeholder="filtrar…" @bind="_fRuc" @bind:event="oninput" /></th>
                        <th><input class="@ClaseFiltro(_fEmpresa)" placeholder="filtrar…" @bind="_fEmpresa" @bind:event="oninput" /></th>
                        <th>
                            <select class="@ClaseFiltro(_fAmbiente)" @bind="_fAmbiente">
                                <option value="">todos</option>
                                <option value="1">Pruebas</option>
                                <option value="2">Producción</option>
                            </select>
                        </th>
                        <th class="num">
                            <input class="@ClaseFiltro(_fPendientesMin)" type="number" min="0" placeholder="mín." @bind="_fPendientesMin" @bind:event="oninput" />
                        </th>
                        <th>
                            <select class="@ClaseFiltro(_fEmision)" @bind="_fEmision">
                                <option value="">todas</option>
                                <option value="con">con emisiones</option>
                                <option value="sin">sin emisiones</option>
                            </select>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (vista.Count == 0)
                    {
                        <tr><td colspan="5" class="psa-muted">Ninguna empresa coincide con el filtro.</td></tr>
                    }
                    @foreach (var f in vista)
                    {
                        <tr class="@(f.Ruc == _empresaSel ? "sel" : null)" @onclick="@(() => SeleccionarEmpresa(f))">
                            <td>@f.Ruc</td>
                            <td>@f.Nombre</td>
                            <td>@AmbienteTexto(f.Ambiente)</td>
                            <td class="num">
                                @if (f.Error is not null)
                                {
                                    <span title="@f.Error">—</span>
                                }
                                else
                                {
                                    @f.Pendientes
                                }
                            </td>
                            <td>
                                @if (f.UltimaEmision is { } fecha)
                                {
                                    @($"{fecha:dd/MM/yyyy} · {f.UltimoNumero}")
                                }
                                else
                                {
                                    <span class="psa-muted">sin emisiones</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        </ChildContent>
    </PsaCard>

    @if (_resumen is not null)
    {
        <PsaCard Title="Resultado de la corrida">
            <p class="psa-muted">
                @_resumen.Inicio.ToString("dd/MM/yyyy HH:mm:ss") — duró
                @((_resumen.Fin - _resumen.Inicio).TotalSeconds.ToString("N1", Ec)) s.
            </p>

            @if (_resumen.DryRun)
            {
                <p class="psa-notice">DRY-RUN: nada se envió a Datil ni se guardó.</p>
            }

            <div class="psa-grid psa-grid--stats" style="margin:1rem 0">
                <PsaStat Label="@(_resumen.DryRun ? "Armadas OK" : "Emitidas")"
                         Value="@_resumen.TotalEmitidas.ToString()" State="ok" />
                <PsaStat Label="Con errores" Value="@_resumen.TotalConErrores.ToString()"
                         State="@(_resumen.TotalConErrores > 0 ? "danger" : "neutral")" />
                <PsaStat Label="Pendientes vistas" Value="@_resumen.TotalPendientes.ToString()" />
            </div>

            @foreach (var e in _resumen.Empresas.Where(x => x.Pendientes > 0 || x.ConErrores > 0))
            {
                <details class="psa-details">
                    <summary>
                        <strong>@e.Nombre</strong> (@e.Ruc) — @e.Emitidas ok, @e.ConErrores con error,
                        @e.Pendientes pendientes
                    </summary>
                    <ul>
                        @foreach (var m in e.Mensajes)
                        {
                            <li>@m</li>
                        }
                    </ul>
                </details>
            }
        </PsaCard>
    }

    <PsaCard Title="@TituloRecientes">
        <Actions>
            @if (_empresaSel is not null)
            {
                <button type="button" class="psa-linkbtn" @onclick="QuitarSeleccion">Ver todas</button>
            }
        </Actions>
        <ChildContent>

        <div class="psa-row" style="margin-bottom:.8rem; align-items:flex-end; gap:.9rem">
            <label class="psa-field">
                <span class="psa-field__lbl">Desde</span>
                <input class="psa-input psa-input--sm" type="date" @bind="_rDesde" @bind:after="RecargarRecientes" />
            </label>
            <label class="psa-field">
                <span class="psa-field__lbl">Hasta</span>
                <input class="psa-input psa-input--sm" type="date" @bind="_rHasta" @bind:after="RecargarRecientes" />
            </label>
            @if (_rDesde is not null || _rHasta is not null)
            {
                <button type="button" class="psa-linkbtn" @onclick="LimpiarRango">Todo el histórico</button>
            }
        </div>

        @if (_rangoInvalido)
        {
            <p class="psa-notice psa-notice--danger">«Desde» no puede ser posterior a «Hasta».</p>
        }
        else if (_empresaSel is null && _rDesde is null && _rHasta is null)
        {
            <p class="psa-muted">
                Hacé clic en una empresa de la tabla de arriba para ver sus retenciones guardadas.
                También podés elegir un rango de fechas para verlas de todas las empresas.
            </p>
        }
        else
        {
        @if (_empresaSel is not null && _rDesde is null && _rHasta is null)
        {
            <label class="psa-check" style="margin-bottom:.6rem; display:inline-flex; gap:.4rem; align-items:center">
                <input type="checkbox" @bind="_incluirPendientes" @bind:after="RecargarRecientes" />
                <span>Incluir las pendientes de emitir@(_pendientesTotal > 0 ? $" ({_pendientesTotal})" : "")</span>
            </label>
        }

        @if (_recientesCargando)
        {
            <p class="psa-muted">Cargando…</p>
        }
        else if ((_recientes is null || _recientes.Count == 0) && _pendientesFilas.Count == 0)
        {
            <p class="psa-notice">No hay retenciones para ese criterio.</p>
        }
        else
        {
            var vista = RecientesVista();
            var colspan = _empresaSel is null ? 8 : 7;
            var mostrarPendientes = _pendientesFilas.Count > 0 && (_rfDatil is "" or "pend");

            <p class="psa-muted" style="margin-bottom:.4rem">
                @vista.Count emitida@(vista.Count == 1 ? "" : "s")
                @if (_recientes is not null && vista.Count != _recientes.Count)
                {
                    <text> de @_recientes.Count traídas</text>
                }
                @if (_recientes is not null && _recientes.Count >= TopRecientes)
                {
                    <text> (tope @TopRecientes — acotá por fecha)</text>
                }
                @if (_incluirPendientes)
                {
                    <text> · @(mostrarPendientes ? _pendientesFilas.Count : 0) pendiente@((mostrarPendientes ? _pendientesFilas.Count : 0) == 1 ? "" : "s")@(_pendientesTotal > _pendientesFilas.Count ? $" de {_pendientesTotal}" : "")</text>
                }
                @if (TieneFiltrosRec)
                {
                    <button type="button" class="psa-linkbtn" @onclick="LimpiarFiltrosRec">Limpiar filtros</button>
                }
            </p>

            <div style="overflow-x:auto">
            <table class="psa-table psa-table--interactiva">
                <thead>
                    <tr>
                        <th class="sortable" @onclick="@(() => OrdenarRec(ColR.Fecha))">Fecha @FlechaRec(ColR.Fecha)</th>
                        @if (_empresaSel is null)
                        {
                            <th class="sortable" @onclick="@(() => OrdenarRec(ColR.Empresa))">Empresa @FlechaRec(ColR.Empresa)</th>
                        }
                        <th class="sortable" @onclick="@(() => OrdenarRec(ColR.Numero))">Número @FlechaRec(ColR.Numero)</th>
                        <th>Secuencial</th>
                        <th class="sortable" @onclick="@(() => OrdenarRec(ColR.Proveedor))">Proveedor @FlechaRec(ColR.Proveedor)</th>
                        <th class="sortable" @onclick="@(() => OrdenarRec(ColR.Ambiente))">Ambiente @FlechaRec(ColR.Ambiente)</th>
                        <th class="num">Datil</th>
                        <th class="num">PDF</th>
                    </tr>
                    <tr class="psa-table__filtros">
                        <th></th>
                        @if (_empresaSel is null)
                        {
                            <th><input class="@ClaseFiltro(_rfEmpresa)" placeholder="filtrar…" @bind="_rfEmpresa" @bind:event="oninput" /></th>
                        }
                        <th><input class="@ClaseFiltro(_rfNumero)" placeholder="filtrar…" @bind="_rfNumero" @bind:event="oninput" /></th>
                        <th></th>
                        <th><input class="@ClaseFiltro(_rfProveedor)" placeholder="filtrar…" @bind="_rfProveedor" @bind:event="oninput" /></th>
                        <th>
                            <select class="@ClaseFiltro(_rfAmbiente)" @bind="_rfAmbiente">
                                <option value="">todos</option>
                                <option value="1">Pruebas</option>
                                <option value="2">Producción</option>
                            </select>
                        </th>
                        <th class="num">
                            <select class="@ClaseFiltro(_rfDatil)" @bind="_rfDatil">
                                <option value="">todos</option>
                                <option value="ok">✓ emitida</option>
                                <option value="sinid">– sin id</option>
                                <option value="pend">✗ pendiente</option>
                            </select>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (vista.Count == 0 && !mostrarPendientes)
                    {
                        <tr><td colspan="@colspan" class="psa-muted">Ninguna retención coincide con el filtro.</td></tr>
                    }
                    @foreach (var r in vista)
                    {
                        <tr style="cursor:pointer" @onclick="() => AbrirDetalle(r)">
                            <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                            @if (_empresaSel is null)
                            {
                                <td>@r.Empresa</td>
                            }
                            <td>@r.Numero</td>
                            <td>@r.Secuencial</td>
                            <td title="@r.ProveedorId">@(r.ProveedorNombre ?? r.ProveedorId ?? "—")</td>
                            <td>@AmbienteTexto(r.Ambiente)</td>
                            <td class="num">
                                @if (r.Emitida)
                                {
                                    <span class="psa-estado psa-estado--ok" title="Enviada a Datil · @r.DatilId">&#10003;</span>
                                }
                                else
                                {
                                    <span class="psa-estado psa-estado--warn" title="Guardada sin id de Datil">&#8211;</span>
                                }
                            </td>
                            <td class="num" @onclick:stopPropagation="true">
                                @if (r.Emitida)
                                {
                                    <a class="psa-pdf" href="@UrlDatil(r.DatilId!, "pdf")" target="_blank" rel="noopener"
                                       title="Abrir el PDF de la retención">PDF</a>
                                }
                                else
                                {
                                    <span class="psa-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (mostrarPendientes)
                {
                    <tbody>
                        <tr class="psa-table__grupo">
                            <td colspan="@colspan">
                                Pendientes de emitir — @_pendientesTotal
                                @if (_pendientesTotal > _pendientesFilas.Count)
                                {
                                    <text>(mostrando @_pendientesFilas.Count)</text>
                                }
                            </td>
                        </tr>
                        @foreach (var p in _pendientesFilas)
                        {
                            <tr>
                                <td class="psa-muted">—</td>
                                @if (_empresaSel is null)
                                {
                                    <td>@p.Empresa</td>
                                }
                                <td class="psa-muted">—</td>
                                <td class="psa-muted" title="Referencia de la compra en Sage 50">@p.Referencia</td>
                                <td class="psa-muted">—</td>
                                <td>@AmbienteTexto(p.Ambiente)</td>
                                <td class="num">
                                    <span class="psa-estado psa-estado--bad" title="Pendiente de emitir">&#10007;</span>
                                </td>
                                <td class="num psa-muted">—</td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
            </div>
        }
        }
        </ChildContent>
    </PsaCard>

    <PsaModal Visible="_detalle is not null || _detalleCargando"
              Title="@(_detalle is null ? "Retención" : $"Retención {_detalle.Numero}")"
              OnClose="CerrarDetalle">
        <ChildContent>
            @if (_detalleCargando)
            {
                <p class="psa-muted">Cargando…</p>
            }
            else if (_detalle is not null)
            {
                <dl class="psa-def">
                    <dt>Empresa</dt><dd>@_detalle.Empresa</dd>
                    <dt>Número</dt><dd>@_detalle.Numero</dd>
                    <dt>Secuencial</dt><dd>@_detalle.Secuencial</dd>
                    <dt>Fecha</dt><dd>@_detalle.Fecha.ToString("dd/MM/yyyy")</dd>
                    <dt>Período fiscal</dt><dd>@_detalle.PeriodoFiscal</dd>
                    <dt>Ambiente</dt><dd>@AmbienteTexto(_detalle.Ambiente)</dd>
                    <dt>Clave de acceso</dt><dd>@(string.IsNullOrWhiteSpace(_detalle.ClaveAcceso) ? "—" : _detalle.ClaveAcceso)</dd>
                    <dt>Id Datil</dt><dd>@(_detalle.DatilId ?? "—")</dd>

                    <div class="psa-def__sub">Proveedor</div>
                    <dt>Nombre</dt><dd>@(_detalle.ProveedorNombre ?? "—")</dd>
                    <dt>Identificación</dt><dd>@_detalle.ProveedorId</dd>
                    <dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(_detalle.ProveedorEmail) ? "—" : _detalle.ProveedorEmail)</dd>
                    <dt>Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(_detalle.ProveedorTelefono) ? "—" : _detalle.ProveedorTelefono)</dd>
                    <dt>Dirección</dt><dd>@(string.IsNullOrWhiteSpace(_detalle.ProveedorDireccion) ? "—" : _detalle.ProveedorDireccion)</dd>
                </dl>

                <div class="psa-def__sub">Líneas (@_detalle.Lineas.Count)</div>
                <div style="overflow-x:auto">
                <table class="psa-table">
                    <thead>
                        <tr>
                            <th>Código</th><th>%</th><th class="num">Base</th><th class="num">Retenido</th>
                            <th>Doc. sustento</th><th>Fecha doc.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_detalle.Lineas.Count == 0)
                        {
                            <tr><td colspan="6" class="psa-muted">Sin líneas.</td></tr>
                        }
                        @foreach (var l in _detalle.Lineas)
                        {
                            <tr>
                                <td>@(l.Codigo == "1" ? "Renta" : l.Codigo == "2" ? "IVA" : l.Codigo)</td>
                                <td>@l.Porcentaje.ToString("0.##", Ec)%</td>
                                <td class="num">@l.BaseImponible.ToString("N2", Ec)</td>
                                <td class="num">@l.ValorRetenido.ToString("N2", Ec)</td>
                                <td>@l.DocSustentoNumero</td>
                                <td>@l.DocSustentoFecha.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="3">Total retenido</td><td class="num">@_detalle.TotalRetenido.ToString("N2", Ec)</td><td colspan="2"></td></tr>
                    </tfoot>
                </table>
                </div>

                <div class="psa-def__sub">Errores</div>
                <p class="psa-muted">Sin errores registrados para esta retención.</p>
            }
        </ChildContent>
        <Footer>
            @if (_detalle is { Emitida: true })
            {
                <a class="psa-btn psa-btn--primary" href="@UrlDatil(_detalle.DatilId!, "pdf")" target="_blank" rel="noopener">Ver PDF</a>
                <a class="psa-btn psa-btn--secondary" href="@UrlDatil(_detalle.DatilId!, "xml")" target="_blank" rel="noopener">Ver XML</a>
                <button type="button" class="psa-btn psa-btn--secondary" @onclick="SolicitarAnulacion" disabled="@_anulando">
                    @(_anulando ? "Enviando…" : "Solicitar anulación")
                </button>
            }
            @if (_avisoAnulacion is not null)
            {
                <span class="psa-muted" style="margin-left:.5rem">@_avisoAnulacion</span>
            }
            <button type="button" class="psa-btn psa-btn--ghost" @onclick="CerrarDetalle">Cerrar</button>
        </Footer>
    </PsaModal>
}

@implements IDisposable

@code {
    private static readonly CultureInfo Ec = CultureInfo.GetCultureInfo("es-EC");

    private enum Col { Ruc, Empresa, Ambiente, Pendientes, UltimaEmision }
    private enum ColR { Fecha, Empresa, Numero, Proveedor, Ambiente }

    private const int TopRecientes = 200;

    private TableroRetenciones? _tablero;
    private ProcesadorRetenciones? _procesador;
    private EjecucionRetencionesGate? _gate;
    private bool _dryRun = true;
    private short? _ambienteForzado;
    private string? _avisoCorrida;

    private IReadOnlyList<FilaTablero>? _panorama;
    private ResumenCorrida? _resumen;
    private string? _errorPanorama;
    private bool _cargando;
    private bool _ejecutando;

    // Alcance: empresa de la sesión (shell) vs. todas (requiere permiso de lote).
    private EmpresaActualService? _empresaActual;
    private string? _rucSesion;
    private bool _puedeTodas;
    private bool _verTodas;

    // Orden y filtros de la tabla de empresas.
    private Col _sortCol = Col.Empresa;
    private bool _sortAsc = true;
    private string _fRuc = "";
    private string _fEmpresa = "";
    private string _fAmbiente = "";
    private int? _fPendientesMin;
    private string _fEmision = "";

    // Selección de empresa + card de retenciones guardadas.
    private string? _empresaSel;
    private string? _empresaSelNombre;
    private short _empresaSelAmbiente;
    private IReadOnlyList<RetencionReciente>? _recientes;
    private bool _recientesCargando;

    // Pendientes de emitir (solo con empresa seleccionada y sin rango de fechas).
    private bool _incluirPendientes = true;
    private IReadOnlyList<RetencionPendiente> _pendientesFilas = Array.Empty<RetencionPendiente>();
    private int _pendientesTotal;

    // Popup de detalle.
    private const string DatilVerBase = "https://app.datil.co/ver/";
    private RetencionDetalle? _detalle;
    private bool _detalleCargando;

    private static string UrlDatil(string datilId, string formato) => $"{DatilVerBase}{datilId}/{formato}";

    private async Task AbrirDetalle(RetencionReciente r)
    {
        if (_tablero is null) return;
        _detalle = null;
        _detalleCargando = true;
        try
        {
            _detalle = await _tablero.DetalleAsync(r.Thid);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando el detalle de la retención {ThId}", r.Thid);
        }
        finally
        {
            _detalleCargando = false;
        }
    }

    private bool _anulando;
    private string? _avisoAnulacion;

    private async Task SolicitarAnulacion()
    {
        if (_detalle is null) return;
        var svc = Sp.GetService<SolicitudAnulacionRetencion>();
        if (svc is null) { _avisoAnulacion = "La solicitud de anulación no está disponible."; return; }

        var ruc = _empresaSel ?? _rucSesion;
        if (ruc is null) { _avisoAnulacion = "No hay empresa seleccionada."; return; }

        _anulando = true;
        _avisoAnulacion = null;
        try
        {
            var usuario = await UsuarioActual();
            var r = await svc.EnviarAsync(ruc, usuario, _detalle.Numero, _detalle.DatilId);
            _avisoAnulacion = r.Mensaje;
        }
        catch (Exception ex)
        {
            _avisoAnulacion = "Error al enviar la solicitud: " + ex.Message;
            Logger.LogError(ex, "Solicitud de anulación de retención");
        }
        finally
        {
            _anulando = false;
        }
    }

    private void CerrarDetalle()
    {
        _detalle = null;
        _detalleCargando = false;
        _avisoAnulacion = null;
    }

    // Filtros / orden de la card de retenciones guardadas.
    private DateOnly? _rDesde;
    private DateOnly? _rHasta;
    private bool _rangoInvalido;
    private string _rfEmpresa = "";
    private string _rfNumero = "";
    private string _rfProveedor = "";
    private string _rfAmbiente = "";
    private string _rfDatil = "";
    private ColR _sortColRec = ColR.Fecha;
    private bool _sortAscRec;

    private bool TieneFiltros =>
        !string.IsNullOrWhiteSpace(_fRuc) || !string.IsNullOrWhiteSpace(_fEmpresa)
        || !string.IsNullOrEmpty(_fAmbiente) || _fPendientesMin is not null
        || !string.IsNullOrEmpty(_fEmision);

    private bool TieneFiltrosRec =>
        !string.IsNullOrWhiteSpace(_rfEmpresa) || !string.IsNullOrWhiteSpace(_rfNumero)
        || !string.IsNullOrWhiteSpace(_rfProveedor) || !string.IsNullOrEmpty(_rfAmbiente)
        || !string.IsNullOrEmpty(_rfDatil);

    private string TituloRecientes =>
        _empresaSel is null ? "Retenciones guardadas" : $"Retenciones guardadas — {_empresaSelNombre}";

    protected override async Task OnInitializedAsync()
    {
        _tablero = Sp.GetService<TableroRetenciones>();
        _procesador = Sp.GetService<ProcesadorRetenciones>();
        _gate = Sp.GetService<EjecucionRetencionesGate>();
        _dryRun = (Sp.GetService<IOptions<DatilOptions>>()?.Value ?? new DatilOptions()).DryRun;
        _ambienteForzado = (Sp.GetService<IOptions<RetencionesOptions>>()?.Value ?? new RetencionesOptions()).AmbienteForzado;

        if (_tablero is null)
        {
            return;
        }

        // Alcance por empresa de sesión (shell). Sin shell, _empresaActual queda
        // null y la página funciona como antes (todas las empresas).
        _empresaActual = Sp.GetService<EmpresaActualService>();
        if (_empresaActual is not null)
        {
            _empresaActual.Cambio += AlCambiarEmpresaSesion;
        }

        // Con shell pero sin empresa rehidratada todavía: esperamos el evento
        // Cambio (lo dispara GuardiaEmpresa). Evita cargar "todas" y después
        // volver a cargar acotado.
        if (_empresaActual is not null && _empresaActual.Ruc is null)
        {
            return;
        }

        await AplicarAlcanceYCargar();
    }

    private bool _aplicandoAlcance;

    private async void AlCambiarEmpresaSesion()
    {
        await AplicarAlcanceYCargar();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AplicarAlcanceYCargar()
    {
        if (_aplicandoAlcance) return;
        _aplicandoAlcance = true;
        try
        {
            await AplicarAlcanceYCargarNucleo();
        }
        finally
        {
            _aplicandoAlcance = false;
        }
    }

    private async Task AplicarAlcanceYCargarNucleo()
    {
        _rucSesion = _empresaActual?.Ruc;
        _puedeTodas = false;

        if (_empresaActual is null)
        {
            _verTodas = true; // sin shell: comportamiento global de siempre
        }
        else if (_rucSesion is not null)
        {
            var dir = Sp.GetService<ISecurityDirectory>();
            if (dir is not null)
            {
                var usuario = await UsuarioActual();
                _puedeTodas = await dir.TienePermisoAsync(usuario, _rucSesion, Permisos.HacerRetencionesLote);
            }
            if (!_puedeTodas) _verTodas = false;
        }

        await CargarPanorama();

        // En modo "mi empresa", el detalle de guardadas arranca en esa empresa.
        if (EnfocadoEnMiEmpresa && _panorama is not null)
        {
            var fila = _panorama.FirstOrDefault(f => f.Ruc == _rucSesion);
            if (fila is not null)
            {
                _empresaSel = fila.Ruc;
                _empresaSelNombre = fila.Nombre;
                _empresaSelAmbiente = fila.Ambiente;
            }
        }

        await RecargarRecientes();
    }

    private bool EnfocadoEnMiEmpresa => _rucSesion is not null && !_verTodas;

    public void Dispose()
    {
        if (_empresaActual is not null) _empresaActual.Cambio -= AlCambiarEmpresaSesion;
    }

    private IReadOnlyList<FilaTablero> FilasVista()
    {
        if (_panorama is null) return Array.Empty<FilaTablero>();

        IEnumerable<FilaTablero> q = _panorama;

        if (EnfocadoEnMiEmpresa)
            q = q.Where(f => f.Ruc == _rucSesion);

        if (!string.IsNullOrWhiteSpace(_fRuc))
            q = q.Where(f => f.Ruc.Contains(_fRuc.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_fEmpresa))
            q = q.Where(f => f.Nombre.Contains(_fEmpresa.Trim(), StringComparison.OrdinalIgnoreCase));
        if (short.TryParse(_fAmbiente, out var amb))
            q = q.Where(f => f.Ambiente == amb);
        if (_fPendientesMin is { } min)
            q = q.Where(f => f.Pendientes >= min);
        if (_fEmision == "con")
            q = q.Where(f => f.UltimaEmision is not null);
        else if (_fEmision == "sin")
            q = q.Where(f => f.UltimaEmision is null);

        IEnumerable<FilaTablero> AplicarOrden<TKey>(Func<FilaTablero, TKey> clave) =>
            _sortAsc ? q.OrderBy(clave) : q.OrderByDescending(clave);

        q = _sortCol switch
        {
            Col.Ruc => AplicarOrden(f => f.Ruc),
            Col.Ambiente => AplicarOrden(f => f.Ambiente),
            Col.Pendientes => AplicarOrden(f => f.Pendientes),
            Col.UltimaEmision => AplicarOrden(f => f.UltimaEmision ?? DateTime.MinValue),
            _ => AplicarOrden(f => f.Nombre),
        };

        return q.ToList();
    }

    private async Task AlternarAlcance()
    {
        _verTodas = !_verTodas;
        _resumen = null;
        _avisoCorrida = null;

        if (EnfocadoEnMiEmpresa && _panorama is not null)
        {
            var fila = _panorama.FirstOrDefault(f => f.Ruc == _rucSesion);
            if (fila is not null)
            {
                _empresaSel = fila.Ruc;
                _empresaSelNombre = fila.Nombre;
                _empresaSelAmbiente = fila.Ambiente;
            }
        }
        await RecargarRecientes();
    }

    private void Ordenar(Col col)
    {
        if (_sortCol == col) _sortAsc = !_sortAsc;
        else { _sortCol = col; _sortAsc = true; }
    }

    private MarkupString Flecha(Col col) =>
        new(_sortCol == col ? (_sortAsc ? "&#9650;" : "&#9660;") : "");

    private void LimpiarFiltros()
    {
        _fRuc = _fEmpresa = _fAmbiente = _fEmision = "";
        _fPendientesMin = null;
    }

    private async Task SeleccionarEmpresa(FilaTablero fila)
    {
        // Segundo clic sobre la misma empresa: la deselecciona.
        if (_empresaSel == fila.Ruc)
        {
            await QuitarSeleccion();
            return;
        }

        _empresaSel = fila.Ruc;
        _empresaSelNombre = fila.Nombre;
        _empresaSelAmbiente = fila.Ambiente;
        await RecargarRecientes();
    }

    private async Task QuitarSeleccion()
    {
        _empresaSel = null;
        _empresaSelNombre = null;
        _pendientesFilas = Array.Empty<RetencionPendiente>();
        _pendientesTotal = 0;
        await RecargarRecientes();
    }

    private async Task RecargarRecientes()
    {
        if (_tablero is null) return;

        _rangoInvalido = _rDesde is { } d && _rHasta is { } h && d > h;
        if (_rangoInvalido)
        {
            _recientes = Array.Empty<RetencionReciente>();
            _pendientesFilas = Array.Empty<RetencionPendiente>();
            _pendientesTotal = 0;
            return;
        }

        // Sin empresa y sin rango: no se muestra ningún detalle.
        if (_empresaSel is null && _rDesde is null && _rHasta is null)
        {
            _recientes = null;
            _pendientesFilas = Array.Empty<RetencionPendiente>();
            _pendientesTotal = 0;
            return;
        }

        var desde = _rDesde?.ToDateTime(TimeOnly.MinValue);
        var hasta = _rHasta?.ToDateTime(TimeOnly.MinValue);

        _recientesCargando = true;
        try
        {
            _recientes = _empresaSel is null
                ? await _tablero.RecientesAsync(desde, hasta, TopRecientes)
                : await _tablero.RecientesPorEmpresaAsync(_empresaSel, desde, hasta, TopRecientes);

            var pediblePendientes = _empresaSel is not null && _incluirPendientes
                && _rDesde is null && _rHasta is null;
            if (pediblePendientes)
            {
                var (filas, total) = await _tablero.PendientesDetalleAsync(
                    _empresaSel!, _empresaSelNombre ?? _empresaSel!, _empresaSelAmbiente, TopRecientes);
                _pendientesFilas = filas;
                _pendientesTotal = total;
            }
            else
            {
                _pendientesFilas = Array.Empty<RetencionPendiente>();
                _pendientesTotal = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando retenciones guardadas");
            _recientes = Array.Empty<RetencionReciente>();
            _pendientesFilas = Array.Empty<RetencionPendiente>();
            _pendientesTotal = 0;
        }
        finally
        {
            _recientesCargando = false;
        }
    }

    private IReadOnlyList<RetencionReciente> RecientesVista()
    {
        if (_recientes is null) return Array.Empty<RetencionReciente>();

        IEnumerable<RetencionReciente> q = _recientes;

        if (!string.IsNullOrWhiteSpace(_rfEmpresa))
            q = q.Where(r => r.Empresa.Contains(_rfEmpresa.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_rfNumero))
            q = q.Where(r => r.Numero.Contains(_rfNumero.Trim(), StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_rfProveedor))
        {
            var f = _rfProveedor.Trim();
            q = q.Where(r =>
                (r.ProveedorNombre ?? "").Contains(f, StringComparison.OrdinalIgnoreCase)
                || (r.ProveedorId ?? "").Contains(f, StringComparison.OrdinalIgnoreCase));
        }
        if (short.TryParse(_rfAmbiente, out var amb))
            q = q.Where(r => r.Ambiente == amb);
        if (_rfDatil == "ok")
            q = q.Where(r => r.Emitida);
        else if (_rfDatil == "sinid")
            q = q.Where(r => !r.Emitida);
        else if (_rfDatil == "pend")
            q = Enumerable.Empty<RetencionReciente>();

        IEnumerable<RetencionReciente> Ordenar<TKey>(Func<RetencionReciente, TKey> clave) =>
            _sortAscRec ? q.OrderBy(clave) : q.OrderByDescending(clave);

        q = _sortColRec switch
        {
            ColR.Empresa => Ordenar(r => r.Empresa),
            ColR.Numero => Ordenar(r => r.Numero),
            ColR.Proveedor => Ordenar(r => r.ProveedorNombre ?? r.ProveedorId ?? ""),
            ColR.Ambiente => Ordenar(r => r.Ambiente),
            _ => Ordenar(r => r.Fecha),
        };

        return q.ToList();
    }

    private void OrdenarRec(ColR col)
    {
        if (_sortColRec == col) _sortAscRec = !_sortAscRec;
        else { _sortColRec = col; _sortAscRec = false; }
    }

    private MarkupString FlechaRec(ColR col) =>
        new(_sortColRec == col ? (_sortAscRec ? "&#9650;" : "&#9660;") : "");

    private void LimpiarFiltrosRec()
    {
        _rfEmpresa = _rfNumero = _rfProveedor = _rfAmbiente = _rfDatil = "";
    }

    private async Task LimpiarRango()
    {
        _rDesde = null;
        _rHasta = null;
        await RecargarRecientes();
    }

    private async Task CargarPanorama()
    {
        if (_tablero is null) return;
        _cargando = true;
        _errorPanorama = null;
        try
        {
            _panorama = await _tablero.PanoramaAsync();

            // Si la empresa seleccionada ya no está activa, volvé a la vista global.
            if (_empresaSel is not null && _panorama.All(f => f.Ruc != _empresaSel))
            {
                _empresaSel = null;
                _empresaSelNombre = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando el panorama de retenciones");
            _errorPanorama = $"No se pudo leer PeachEBills: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task EjecutarAhora()
    {
        if (_procesador is null || _gate is null) return;
        _ejecutando = true;
        _resumen = null;
        _avisoCorrida = null;
        try
        {
            var usuario = await UsuarioActual();
            var procesador = _procesador;
            var resultado = EnfocadoEnMiEmpresa
                ? await _gate.EjecutarAsync(usuario, ct => procesador.ProcesarUnaAsync(_rucSesion!, usuario, ct))
                : await _gate.EjecutarAsync(usuario, ct => procesador.ProcesarTodasAsync(usuario, ct));

            if (!resultado.Ejecuto)
            {
                _avisoCorrida = resultado.Motivo;
                return;
            }

            _resumen = resultado.Resumen;
            await CargarPanorama();
            await RecargarRecientes();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error ejecutando la corrida de retenciones");
            _errorPanorama = $"La corrida falló: {ex.Message}";
        }
        finally
        {
            _ejecutando = false;
        }
    }

    private async Task<string> UsuarioActual()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "web";
    }

    private static string AmbienteTexto(short ambiente) => ambiente == 1 ? "Pruebas" : "Producción";

