@page "/conciliacion-sri"
@namespace PsaWeb.Modules.ConciliacionSri.Pages
@using Microsoft.Extensions.Options
@using PsaWeb.Comprobantes.Compras
@using PsaWeb.Conciliacion
@using PsaWeb.Sage50
@inject ProcesadorVerificacionEstado Procesador
@inject EjecucionVerificacionGate Gate
@inject IResolverEmpresaSage EmpresaSage
@inject IOptions<ConciliacionOptions> Opciones
@inject AuthenticationStateProvider AuthState
@inject ILogger<ConciliacionSri> Logger
@implements IDisposable

<PageTitle>Conciliación con SRI - Docs Recibidos — Aplicativos web PSA</PageTitle>

<PsaPageHeader Title="Conciliación con SRI - Docs Recibidos"
               Subtitle="Concilia los documentos electrónicos recibidos del SRI (facturas, notas de crédito y retenciones, subidos por la extensión de Chrome) contra lo registrado en Sage 50." />

@if (EmpresaSage.RucSesion is null)
{
    <PsaCard Title="Conciliación con SRI - Docs Recibidos">
        <p class="psa-notice psa-notice--danger">Este módulo necesita una empresa de sesión activa.</p>
    </PsaCard>
}
else
{
    <PsaCard Title="Período">
        <PsaDateRange From="_desde" To="_hasta" FromChanged="v => _desde = v" ToChanged="v => _hasta = v" />
        <div class="psa-row" style="margin-top:1rem;gap:1.2rem;align-items:center">
            <span class="psa-field__lbl">Documentos a conciliar</span>
            @foreach (var tipo in TiposConciliables)
            {
                <label class="psa-row" style="align-items:center;gap:.4rem;cursor:pointer">
                    <input type="checkbox" style="width:1.05rem;height:1.05rem;accent-color:var(--psa-magenta,#B40046)"
                           checked="@_tipos.Contains(tipo)" @onchange="e => AlternarTipo(tipo, (bool)e.Value!)" />
                    @EtiquetaPlural(tipo)
                </label>
            }
        </div>
        <div class="psa-row" style="margin-top:1rem">
            <PsaButton Variant="primary" OnClick="Consultar" Disabled="_cargando">
                @(_cargando ? "Consultando…" : "Consultar")
            </PsaButton>
        </div>
        <p class="psa-muted" style="margin-top:.6rem">
            Recordatorio: el listado de "recibidos" del portal del SRI solo cubre bien los últimos 5 días del mes en
            curso — si el período no está completo, corré la extensión de nuevo antes de confiar en el resultado.
        </p>
    </PsaCard>

    @if (_error is not null)
    {
        <PsaCard Title="Conciliación con SRI - Docs Recibidos">
            <p class="psa-notice psa-notice--danger">@_error</p>
        </PsaCard>
    }
    else if (_filas is not null)
    {
        // Solo las que todavía tiene sentido verificar: sin verificar (o con la verificación vencida) y dentro del
        // rango que responde el SRI. Las ya verificadas no cuentan, así el número baja al terminar.
        var pendientesDeVerificar = Procesador.CandidatasAVerificar(_filas.Select(f => f.Fila)).Count;

        <PsaCard Title="Resultado">
            <Actions>
                <PsaButton Variant="secondary" OnClick="VerificarPendientes" Disabled="@(_verificando || pendientesDeVerificar == 0)">
                    @(_verificando ? $"Verificando… {_progreso}/{_totalVerificar}" : $"Verificar pendientes ({pendientesDeVerificar})")
                </PsaButton>
            </Actions>
            <ChildContent>

            @if (_ultimaVerificacionMasiva is not null)
            {
                <p class="psa-muted" style="margin-top:-.6rem">
                    Última verificación: @DateTime.SpecifyKind(_ultimaVerificacionMasiva.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </p>
            }

            @if (_avisoVerificacion is not null)
            {
                <p class="psa-notice">@_avisoVerificacion</p>
            }

            @foreach (var advertencia in _advertencias)
            {
                <p class="psa-notice psa-notice--danger">@advertencia</p>
            }

            <div class="psa-grid psa-grid--stats" style="margin-bottom:1rem">
                @foreach (var (clasificacion, etiqueta) in Etiquetas)
                {
                    var cantidad = _filas.Count(f => f.Fila.Clasificacion == clasificacion);
                    <button type="button" style="@EstiloFiltro(clasificacion)" @onclick="() => CambiarListado(clasificacion)">
                        <PsaStat Label="@etiqueta" Value="@cantidad.ToString()"
                                 State="@(clasificacion is ClasificacionConciliacion.SoloEnSri or ClasificacionConciliacion.SoloEnSage or ClasificacionConciliacion.ValoresDistintos && cantidad > 0 ? "warn" : "ok")" />
                    </button>
                }
            </div>

            @if (_filtro == ClasificacionConciliacion.SoloEnSage)
            {
                <p class="psa-notice">
                    "Solo en Sage" puede ser por clave de acceso vacía o mal tecleada, o por una factura física (sin
                    comprobante electrónico, marcada como <strong>"Documento físico"</strong> más abajo) — no
                    necesariamente porque el comprobante sea inválido. Ver el detalle de cada fila.
                </p>
            }

            @{
                var delListado = _filas.Where(f => f.Fila.Clasificacion == _filtro).ToList();
                var vista = VistaConciliacion.Aplicar(delListado, Criterios);
                var puedeAceptar = _filtro != ClasificacionConciliacion.CoincidePendienteDeVerificar;
            }
            @if (delListado.Count == 0)
            {
                <p class="psa-muted">Sin filas en esta categoría.</p>
            }
            else
            {
                <div class="psa-row" style="margin:0 0 .7rem;gap:1rem">
                    <input class="@ClaseFiltro(_busqueda)" style="max-width:20rem" placeholder="Buscar en este listado…"
                           @bind="_busqueda" @bind:event="oninput" />
                    <label class="psa-row" style="align-items:center;gap:.5rem;cursor:pointer;font-weight:700;color:var(--psa-magenta,#B40046)">
                        <input type="checkbox" style="width:1.15rem;height:1.15rem;accent-color:var(--psa-magenta,#B40046)"
                               checked="@_mostrarClave" @onchange="e => _mostrarClave = (bool)e.Value!" />
                        Mostrar clave de acceso
                    </label>
                    @if (Criterios.HayFiltros)
                    {
                        <button type="button" class="psa-linkbtn" @onclick="LimpiarFiltros">Limpiar filtros</button>
                    }
                    <span class="psa-muted">@vista.Count de @delListado.Count</span>
                </div>
                <div style="overflow-x:auto">
                <table class="psa-table">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick="() => Ordenar(ColumnaConciliacion.Tipo)">Tipo @Flecha(ColumnaConciliacion.Tipo)</th>
                            <th class="sortable" @onclick="() => Ordenar(ColumnaConciliacion.Documento)">
                                @(_filtro == ClasificacionConciliacion.SoloEnSri ? "Documento (SRI)" : "Documento (Sage)") @Flecha(ColumnaConciliacion.Documento)
                            </th>
                            <th class="sortable" @onclick="() => Ordenar(ColumnaConciliacion.ProveedorSri)">Emisor (SRI) @Flecha(ColumnaConciliacion.ProveedorSri)</th>
                            <th class="sortable" @onclick="() => Ordenar(ColumnaConciliacion.ProveedorSage)">Emisor (Sage) @Flecha(ColumnaConciliacion.ProveedorSage)</th>
                            <th class="num sortable" @onclick="() => Ordenar(ColumnaConciliacion.TotalSri)">Total (SRI) @Flecha(ColumnaConciliacion.TotalSri)</th>
                            <th class="num sortable" @onclick="() => Ordenar(ColumnaConciliacion.TotalSage)">Total (Sage) @Flecha(ColumnaConciliacion.TotalSage)</th>
                            <th class="sortable" @onclick="() => Ordenar(ColumnaConciliacion.EstadoSri)">Estado en SRI @Flecha(ColumnaConciliacion.EstadoSri)</th>
                            <th>Diferencias</th>
                            @if (puedeAceptar)
                            {
                                <th class="sortable" @onclick="() => Ordenar(ColumnaConciliacion.Revision)">Revisión @Flecha(ColumnaConciliacion.Revision)</th>
                            }
                            <th></th>
                            @if (_mostrarClave)
                            {
                                <th>Clave de acceso</th>
                            }
                        </tr>
                        <tr class="psa-table__filtros">
                            <th>
                                <select class="@ClaseFiltro(_fTipo)" @bind="_fTipo">
                                    <option value="">Todos</option>
                                    @foreach (var tipo in TiposConciliables)
                                    {
                                        <option value="@tipo">@TiposDocumentoRecibido.Etiqueta(tipo)</option>
                                    }
                                </select>
                            </th>
                            <th><input class="@ClaseFiltro(_fDocumento)" placeholder="buscar…" @bind="_fDocumento" @bind:event="oninput" /></th>
                            <th><input class="@ClaseFiltro(_fProveedorSri)" placeholder="buscar…" @bind="_fProveedorSri" @bind:event="oninput" /></th>
                            <th><input class="@ClaseFiltro(_fProveedorSage)" placeholder="buscar…" @bind="_fProveedorSage" @bind:event="oninput" /></th>
                            <th></th>
                            <th></th>
                            <th>
                                <select class="@ClaseFiltro(_fEstadoSri)" @bind="_fEstadoSri">
                                    <option value="">Todos</option>
                                    <option value="@CriteriosVista.EstadoSinVerificar">Sin verificar</option>
                                    <option value="@CriteriosVista.EstadoAutorizado">Autorizado</option>
                                    <option value="@CriteriosVista.EstadoNoVigente">Anulado / No autorizado</option>
                                    <option value="@CriteriosVista.EstadoOtro">Otros</option>
                                </select>
                            </th>
                            <th><input class="@ClaseFiltro(_fDiferencias)" placeholder="buscar…" @bind="_fDiferencias" @bind:event="oninput" /></th>
                            @if (puedeAceptar)
                            {
                                <th>
                                    <select class="@ClaseFiltro(_fRevision)" @bind="_fRevision">
                                        <option value="">Todas</option>
                                        <option value="@CriteriosVista.RevisionPendientes">Por revisar</option>
                                        <option value="@CriteriosVista.RevisionRevisadas">Revisadas OK</option>
                                    </select>
                                </th>
                            }
                            <th></th>
                            @if (_mostrarClave)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (vista.Count == 0)
                        {
                            <tr><td colspan="@(8 + (puedeAceptar ? 1 : 0) + 1 + (_mostrarClave ? 1 : 0))" class="psa-muted">Ninguna fila coincide con el filtro.</td></tr>
                        }
                        @foreach (var d in vista)
                        {
                            var fila = d.Fila;
                            <tr style="@(d.Aceptable ? "cursor:pointer" : "")" @onclick="() => AbrirDetalle(d)">
                                <td>@d.TipoTexto</td>
                                <td>
                                    @d.Documento
                                    @if (fila.Clasificacion == ClasificacionConciliacion.SoloEnSage && DocumentoFisico.EsProbable(fila.ClaveAcceso))
                                    {
                                        <br /><span class="psa-estado psa-estado--warn" style="font-size:.7rem">Documento físico</span>
                                    }
                                </td>
                                <td>@d.ProveedorSri</td>
                                <td>@d.ProveedorSage</td>
                                <td class="num">@(fila.Sri is not null && d.SriTieneMontos ? fila.Sri.Total.ToString("N2") : "")</td>
                                <td class="num">@(fila.Sage is not null ? fila.Sage.Total.ToString("N2") : "")</td>
                                <td>
                                    @if (fila.Sri is null)
                                    {
                                        <span class="psa-muted">—</span>
                                    }
                                    else
                                    {
                                        var (textoEstado, claseEstado) = EstadoVisual(fila.Sri.Estado);
                                        <span class="psa-estado @claseEstado" style="font-size:.85rem">@textoEstado</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var dif in fila.Diferencias)
                                    {
                                        var (campo, resto) = PartirDiferencia(dif);
                                        <div><strong>@campo:</strong>@resto</div>
                                    }
                                    @if (fila.Diferencias.Count == 0)
                                    {
                                        <span class="psa-muted">@Hallazgo(fila)</span>
                                    }
                                    @if (fila.EnPlazo)
                                    {
                                        <br /><span class="psa-estado psa-estado--warn" style="font-size:.75rem"
                                                    title="El SRI da @Plazo días para emitir una retención después de la venta: puede no haberse emitido o registrado todavía.">En plazo (@Plazo días)</span>
                                    }
                                </td>
                                @if (puedeAceptar)
                                {
                                    <td>
                                        @if (d.EstadoRevision == EstadoRevision.Revisada)
                                        {
                                            <span class="psa-estado psa-estado--ok" style="font-size:.75rem"
                                                  title="@TextoRevision(d.Revision!)">✓ Revisada OK</span>
                                        }
                                        else if (d.EstadoRevision == EstadoRevision.Desactualizada)
                                        {
                                            <span class="psa-estado psa-estado--warn" style="font-size:.75rem"
                                                  title="Se revisó, pero el hallazgo cambió desde entonces. @TextoRevision(d.Revision!)">↻ Cambió, revisar</span>
                                        }
                                        else
                                        {
                                            <span class="psa-muted" style="font-size:.8rem">Por revisar</span>
                                        }
                                    </td>
                                }
                                <td @onclick:stopPropagation="true">
                                    @if (fila.ClaveAcceso is not null && fila.Sri is not null)
                                    {
                                        <PsaButton Variant="ghost" OnClick="@(() => VerificarUna(fila.Sri.Id, fila.ClaveAcceso))"
                                                   Disabled="_verificandoFila == fila.Sri.Id">
                                            @(_verificandoFila == fila.Sri.Id ? "…" : "Verificar con el SRI")
                                        </PsaButton>
                                    }
                                </td>
                                @if (_mostrarClave)
                                {
                                    <td>@fila.ClaveAcceso</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }

            </ChildContent>
        </PsaCard>
    }
}

<PsaModal Visible="_detalle is not null" Title="@("Comprobante " + _detalle?.Documento)" OnClose="CerrarDetalle">
    <ChildContent>
        @if (_detalle is { } d)
        {
            var fila = d.Fila;
            <div class="psa-grid" style="grid-template-columns:1fr 1fr">
                <div>
                    <h3 style="margin:0 0 .4rem">SRI</h3>
                    @if (fila.Sri is null)
                    {
                        <p class="psa-muted" style="margin:.2rem 0">No hay comprobante del SRI para este documento.</p>
                    }
                    else
                    {
                        var (textoEstado, claseEstado) = EstadoVisual(fila.Sri.Estado);
                        <p class="psa-muted" style="margin:.2rem 0">@fila.Sri.RazonSocialEmisor (@fila.Sri.RucEmisor)</p>
                        <p class="psa-muted" style="margin:.2rem 0">Serie: @fila.Sri.SerieComprobante</p>
                        <p class="psa-muted" style="margin:.2rem 0">Fecha emisión: @fila.Sri.FechaEmision.ToString("dd/MM/yyyy")</p>
                        <p class="psa-muted" style="margin:.2rem 0">Tipo: @fila.Sri.TipoComprobante</p>
                        @if (fila.Sri.TieneMontos)
                        {
                            <p class="psa-muted" style="margin:.2rem 0">
                                Subtotal @fila.Sri.Subtotal.ToString("N2") · IVA @fila.Sri.Iva.ToString("N2") ·
                                Total @fila.Sri.Total.ToString("N2")
                            </p>
                        }
                        else
                        {
                            <p class="psa-muted" style="margin:.2rem 0">El reporte del SRI no trae montos de las retenciones: solo se compara documento, fecha y emisor.</p>
                        }
                        @if (fila.Sri.Tipo == TipoDocumentoRecibido.NotaCredito && !string.IsNullOrWhiteSpace(fila.Sri.NumeroDocumentoModificado))
                        {
                            <p class="psa-muted" style="margin:.2rem 0">Documento modificado: @fila.Sri.NumeroDocumentoModificado</p>
                        }
                        <p class="psa-muted" style="margin:.2rem 0">Estado en SRI: <span class="psa-estado @claseEstado" style="font-size:.85rem">@textoEstado</span></p>
                    }
                </div>
                <div>
                    <h3 style="margin:0 0 .4rem">Sage</h3>
                    @if (fila.Sage is null)
                    {
                        <p class="psa-muted" style="margin:.2rem 0">Este documento no está registrado en Sage.</p>
                    }
                    else
                    {
                        <p class="psa-muted" style="margin:.2rem 0">@fila.Sage.NombreProveedor (@fila.Sage.RucProveedor)</p>
                        <p class="psa-muted" style="margin:.2rem 0">Referencia: @fila.Sage.Referencia</p>
                        <p class="psa-muted" style="margin:.2rem 0">Fecha: @fila.Sage.Fecha.ToString("dd/MM/yyyy")</p>
                        <p class="psa-muted" style="margin:.2rem 0">Tipo: @TiposDocumentoRecibido.Etiqueta(fila.Sage.Tipo)</p>
                        @if (fila.Sage.Tipo == TipoDocumentoRecibido.Retencion)
                        {
                            <p class="psa-muted" style="margin:.2rem 0">Total de la retención: @fila.Sage.Total.ToString("N2")</p>
                        }
                        else
                        {
                            <p class="psa-muted" style="margin:.2rem 0">
                                Subtotal @fila.Sage.Subtotal.ToString("N2") · IVA @fila.Sage.Iva.ToString("N2") ·
                                Total @fila.Sage.Total.ToString("N2")
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(fila.Sage.DocumentoModificado))
                        {
                            <p class="psa-muted" style="margin:.2rem 0">Documento modificado: @fila.Sage.DocumentoModificado</p>
                        }
                    }
                </div>
            </div>

            @if (fila.Sage is not null)
            {
                <h3 style="margin:1rem 0 .4rem">Líneas del documento en Sage</h3>
                @if (_lineasSageCargando)
                {
                    <p class="psa-muted">Cargando…</p>
                }
                else if (_lineasSageError is not null)
                {
                    <p class="psa-notice psa-notice--danger">@_lineasSageError</p>
                }
                else if (_lineasSage is { Count: 0 })
                {
                    <p class="psa-muted">Sin líneas.</p>
                }
                else if (_lineasSage is not null)
                {
                    <div style="overflow-x:auto">
                    <table class="psa-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Descripción</th>
                                <th class="num">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in _lineasSage)
                            {
                                <tr>
                                    <td>@linea.ItemId</td>
                                    <td>@linea.Descripcion</td>
                                    <td class="num">@linea.Monto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            }

            <h3 style="margin:1rem 0 .4rem">Hallazgo</h3>
            @foreach (var dif in fila.Diferencias)
            {
                var (campo, resto) = PartirDiferencia(dif);
                <p style="margin:.2rem 0"><strong>@campo:</strong>@resto <strong>@DiferenciaEnSage(fila, campo)</strong></p>
            }
            @if (fila.Diferencias.Count == 0)
            {
                <p style="margin:.2rem 0">@Hallazgo(fila)</p>
            }
            @if (fila.EnPlazo)
            {
                <p style="margin:.2rem 0">
                    <span class="psa-estado psa-estado--warn" style="font-size:.8rem">En plazo (@Plazo días)</span>
                    <span class="psa-muted">— el SRI da @Plazo días para emitir una retención después de la venta, así que puede no haberse emitido o registrado todavía. Revisala pasado ese plazo.</span>
                </p>
            }
            @if (fila.Clasificacion == ClasificacionConciliacion.SoloEnSage && DocumentoFisico.EsProbable(fila.ClaveAcceso))
            {
                <p style="margin:.2rem 0">
                    <span class="psa-estado psa-estado--warn" style="font-size:.8rem">Documento físico</span>
                    <span class="psa-muted">— la autorización tecleada ("@fila.ClaveAcceso") no tiene 49 dígitos, por eso no aparece en el SRI.</span>
                </p>
            }

            @if (d.EstadoRevision == EstadoRevision.Revisada)
            {
                var rev = d.Revision!;
                <p class="psa-notice psa-notice--ok" style="margin-top:1rem">
                    Revisada OK por <strong>@rev.RevisadaPor</strong> el @FechaLocal(rev.RevisadaUtc).
                    <br />Comentario: "@rev.Comentario"
                </p>
                <div class="psa-row" style="margin-top:.6rem">
                    <PsaButton Variant="ghost" OnClick="QuitarRevision" Disabled="_procesandoRevision">Quitar revisión</PsaButton>
                </div>
            }
            else
            {
                @if (d.EstadoRevision == EstadoRevision.Desactualizada)
                {
                    var previa = d.Revision!;
                    <p class="psa-notice" style="margin-top:1rem">
                        Este hallazgo ya se había revisado (@previa.RevisadaPor, @FechaLocal(previa.RevisadaUtc):
                        "@previa.Comentario"), pero <strong>cambió desde entonces</strong>. Revisalo de nuevo.
                    </p>
                }
                <div class="psa-field" style="margin-top:1rem;max-width:100%;width:100%">
                    <span class="psa-field__lbl">Comentario (obligatorio) — ej. "Corresponde a ICE", "Factura física conciliada a mano"</span>
                    <textarea class="psa-input" style="width:100%" rows="3" maxlength="@ClaveRevision.MaxComentario"
                              @bind="_comentarioRevision" @bind:event="oninput"></textarea>
                </div>
                @if (_errorRevision is not null)
                {
                    <p class="psa-notice psa-notice--danger" style="margin-top:.6rem">@_errorRevision</p>
                }
                <div class="psa-row" style="margin-top:.6rem">
                    <PsaButton Variant="secondary" OnClick="Aceptar"
                               Disabled="@(_procesandoRevision || string.IsNullOrWhiteSpace(_comentarioRevision))">
                        @(_procesandoRevision ? "Guardando…" : "Aceptar diferencia / Revisada OK")
                    </PsaButton>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <PsaButton Variant="ghost" OnClick="CerrarDetalle">Cerrar</PsaButton>
    </Footer>
</PsaModal>

@code {
    private static readonly (ClasificacionConciliacion, string)[] Etiquetas =
    [
        (ClasificacionConciliacion.SoloEnSri, "Solo en SRI"),
        (ClasificacionConciliacion.SoloEnSage, "Solo en Sage"),
        (ClasificacionConciliacion.ValoresDistintos, "Valores distintos"),
        (ClasificacionConciliacion.MetadataDistinta, "Metadata distinta"),
        (ClasificacionConciliacion.CoincidePendienteDeVerificar, "Conciliado"),
    ];

    // Facturas, notas de crédito y retenciones de venta recibidas. Las liquidaciones de compra y notas de
    // débito recibidas no se contemplan (sin casos en más de 5 años de Sage).
    private static readonly TipoDocumentoRecibido[] TiposConciliables =
        [TipoDocumentoRecibido.Factura, TipoDocumentoRecibido.NotaCredito, TipoDocumentoRecibido.Retencion];

    private static string EtiquetaPlural(TipoDocumentoRecibido tipo) => tipo switch
    {
        TipoDocumentoRecibido.Factura => "Facturas de compra",
        TipoDocumentoRecibido.NotaCredito => "Notas de crédito",
        TipoDocumentoRecibido.Retencion => "Retenciones de venta",
        _ => tipo.ToString(),
    };

    private int Plazo => Opciones.Value.RetencionPlazoDias;

    private readonly HashSet<TipoDocumentoRecibido> _tipos = [.. TiposConciliables];
    private IReadOnlyList<string> _advertencias = [];
    private string _fTipo = "";

    private void AlternarTipo(TipoDocumentoRecibido tipo, bool marcado)
    {
        if (marcado)
        {
            _tipos.Add(tipo);
        }
        else
        {
            _tipos.Remove(tipo);
        }
    }

    private DateOnly _desde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly _hasta = DateOnly.FromDateTime(DateTime.Today);
    private bool _cargando;
    private bool _verificando;
    private int _progreso;
    private int _totalVerificar;
    private long? _verificandoFila;
    private string? _error;
    private string? _avisoVerificacion;
    private DateTime? _ultimaVerificacionMasiva;
    private List<FilaConRevision>? _filas;
    private ClasificacionConciliacion _filtro = ClasificacionConciliacion.SoloEnSri;
    private string? _usuarioActual;
    private bool _mostrarClave;

    // Filtros, búsqueda y orden del listado (la clave de acceso queda fuera a propósito).
    private string _busqueda = "";
    private string _fDocumento = "";
    private string _fProveedorSri = "";
    private string _fProveedorSage = "";
    private string _fDiferencias = "";
    private string _fEstadoSri = "";
    private string _fRevision = "";
    private ColumnaConciliacion? _ordenColumna;
    private bool _ordenAscendente = true;

    private CriteriosVista Criterios => new(
        _busqueda, _fDocumento, _fProveedorSri, _fProveedorSage, _fDiferencias, _fEstadoSri, _fRevision, _fTipo,
        _ordenColumna, _ordenAscendente);

    // Popup de detalle / revisión manual.
    private FilaConRevision? _detalle;
    private string _comentarioRevision = "";
    private bool _procesandoRevision;
    private string? _errorRevision;
    private IReadOnlyList<LineaCompraSage>? _lineasSage;
    private bool _lineasSageCargando;
    private string? _lineasSageError;

    protected override async Task OnInitializedAsync()
    {
        EmpresaSage.Cambio += Refrescar;
        var estado = await AuthState.GetAuthenticationStateAsync();
        _usuarioActual = estado.User.Identity?.Name ?? "desconocido";
    }

    public void Dispose() => EmpresaSage.Cambio -= Refrescar;

    private void Refrescar()
    {
        _filas = null;
        _error = null;
        _advertencias = [];
        _avisoVerificacion = null;
        _ultimaVerificacionMasiva = null;
        _detalle = null;
        LimpiarFiltros();
        InvokeAsync(StateHasChanged);
    }

    private string EstiloFiltro(ClasificacionConciliacion c) =>
        "border:none;background:none;padding:0;text-align:left;cursor:pointer;border-radius:8px;"
        + (c == _filtro ? "outline:2px solid var(--psa-magenta,#B40046)" : "outline:none");

    private void CambiarListado(ClasificacionConciliacion c)
    {
        if (c == _filtro)
        {
            return;
        }

        _filtro = c;
        LimpiarFiltros(); // un filtro puesto en otro listado no debe esconder filas sin que se note
    }

    private void LimpiarFiltros() =>
        _busqueda = _fDocumento = _fProveedorSri = _fProveedorSage = _fDiferencias = _fEstadoSri = _fRevision = _fTipo = "";

    private static string ClaseFiltro(string valor) =>
        "psa-input psa-input--sm" + (string.IsNullOrEmpty(valor) ? "" : " psa-input--activo");

    private void Ordenar(ColumnaConciliacion columna)
    {
        if (_ordenColumna == columna)
        {
            _ordenAscendente = !_ordenAscendente;
        }
        else
        {
            _ordenColumna = columna;
            _ordenAscendente = true;
        }
    }

    private MarkupString Flecha(ColumnaConciliacion columna) =>
        new(_ordenColumna == columna ? (_ordenAscendente ? " ▲" : " ▼") : "");

    private static (string Texto, string Clase) EstadoVisual(string? estado) => EstadoSriPresentacion.Visual(estado);

    private static string Hallazgo(FilaConciliacion f) => f.Clasificacion switch
    {
        ClasificacionConciliacion.SoloEnSri => "Falta registrarla en Sage.",
        ClasificacionConciliacion.SoloEnSage when f.Tipo == TipoDocumentoRecibido.Retencion =>
            "No hay retención en el SRI con este emisor y esta serie.",
        ClasificacionConciliacion.SoloEnSage => "No hay comprobante en el SRI con esta autorización.",
        _ => "",
    };

    private static string FechaLocal(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private static string TextoRevision(RevisionDeFila r) =>
        $"{r.RevisadaPor}, {FechaLocal(r.RevisadaUtc)}: {r.Comentario}";

    /// <summary>"→ Sage +4.85" / "→ Sage −4.85": cuánto se aparta Sage del SRI en un campo de monto (vacío si no aplica).</summary>
    private static string DiferenciaEnSage(FilaConciliacion fila, string campo) =>
        VistaConciliacion.ValorDiferencia(fila, campo) is { } d
            ? $"→ Sage {(d > 0 ? "+" : d < 0 ? "−" : "")}{Math.Abs(d):N2}"
            : "";

    /// <summary>"Subtotal: SRI 969.47 vs Sage 974.32" → ("Subtotal", " SRI 969.47 vs Sage 974.32") para resaltar el campo.</summary>
    private static (string Campo, string Resto) PartirDiferencia(string diferencia)
    {
        var i = diferencia.IndexOf(':');
        return i < 0 ? (diferencia, "") : (diferencia[..i], diferencia[(i + 1)..]);
    }

    private async Task Consultar()
    {
        if (EmpresaSage.RucSesion is not { } ruc)
        {
            return;
        }

        _cargando = true;
        _error = null;
        _avisoVerificacion = null;
        try
        {
            var resultado = await Procesador.ConciliarConRevisionesAsync(ruc, _desde, _hasta, _tipos);
            _filas = resultado.Filas.ToList();
            _advertencias = resultado.Advertencias;
            if (_ultimaVerificacionMasiva is null)
            {
                var fechas = _filas
                    .Where(f => f.Fila.Sri?.FechaVerificacionEstado is not null)
                    .Select(f => f.Fila.Sri!.FechaVerificacionEstado!.Value)
                    .ToList();
                if (fechas.Count > 0)
                {
                    _ultimaVerificacionMasiva = fechas.Max();
                }
            }
        }
        catch (Exception ex)
        {
            _error = $"No se pudo conciliar: {ex.Message}";
            Logger.LogError(ex, "Conciliación SRI para {Ruc}", ruc);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task VerificarUna(long comprobanteId, string claveAcceso)
    {
        _verificandoFila = comprobanteId;
        try
        {
            _avisoVerificacion = null;
            string? aviso = null;
            var resultado = await Procesador.VerificarUnaAsync(comprobanteId, claveAcceso);
            if (resultado.Estado == EstadoComprobanteSri.FueraDeRango)
            {
                aviso = "El SRI solo permite consultar comprobantes del mes en curso y el mes anterior; este es más antiguo.";
            }
            else if (resultado.Estado == EstadoComprobanteSri.ErrorServicio)
            {
                aviso = $"El SRI no respondió: {resultado.MensajeSri}";
            }
            await Consultar(); // vuelve a conciliar para reflejar el estado ya guardado
            if (aviso is not null) _avisoVerificacion = aviso;
        }
        finally
        {
            _verificandoFila = null;
        }
    }

    private async Task VerificarPendientes()
    {
        if (EmpresaSage.RucSesion is not { } ruc)
        {
            return;
        }

        // Verifica exactamente lo que la pantalla cuenta como pendiente (no una ventana aparte del worker).
        var candidatas = Procesador.CandidatasAVerificar(_filas!.Select(f => f.Fila));
        if (candidatas.Count == 0)
        {
            return;
        }

        _verificando = true;
        _progreso = 0;
        _totalVerificar = candidatas.Count;
        _avisoVerificacion = null;
        try
        {
            var avance = new Progress<int>(n =>
            {
                _progreso = n;
                _ = InvokeAsync(StateHasChanged);
            });
            var resultado = await Gate.EjecutarAsync(ct => Procesador.VerificarFilasAsync(ruc, ruc, candidatas, avance, ct));
            if (!resultado.Ejecuto)
            {
                _avisoVerificacion = resultado.Motivo;
                return;
            }

            var r = resultado.Resumen!.Empresas[0];
            var resumen = $"Verificados: {r.Verificados} · Anulados: {r.Anulados} · Con error: {r.ConErrores}.";
            var sinResponder = candidatas.Count - r.Verificados - r.ConErrores;
            if (sinResponder > 0)
            {
                resumen += $" {sinResponder} sin respuesta del SRI (fuera de rango).";
            }

            _ultimaVerificacionMasiva = resultado.Resumen.Fin.UtcDateTime;
            await Consultar(); // refleja los estados ya guardados (y limpia el aviso, por eso se arma después)
            _avisoVerificacion = resumen;
        }
        finally
        {
            _verificando = false;
        }
    }

    private async Task AbrirDetalle(FilaConRevision fila)
    {
        if (!fila.Aceptable)
        {
            return;
        }

        _detalle = fila;
        _comentarioRevision = "";
        _errorRevision = null;
        await CargarLineasSageAsync(fila);
    }

    // Las líneas de Sage solo aplican donde hay compra registrada en Sage (no en "Solo en SRI").
    private async Task CargarLineasSageAsync(FilaConRevision fila)
    {
        _lineasSage = null;
        _lineasSageError = null;
        if (fila.Fila.Sage is null || EmpresaSage.RucSesion is not { } ruc)
        {
            return;
        }

        _lineasSageCargando = true;
        try
        {
            _lineasSage = await Procesador.LeerLineasSageAsync(ruc, fila.Fila.Sage.PostOrder, fila.Fila.Sage.Tipo);
        }
        catch (Exception ex)
        {
            _lineasSageError = $"No se pudo cargar el detalle: {ex.Message}";
            Logger.LogError(ex, "Líneas de Sage para PostOrder {PostOrder}", fila.Fila.Sage.PostOrder);
        }
        finally
        {
            _lineasSageCargando = false;
        }
    }

    private void CerrarDetalle()
    {
        _detalle = null;
        _comentarioRevision = "";
        _errorRevision = null;
        _lineasSage = null;
        _lineasSageError = null;
    }

    private async Task Aceptar()
    {
        if (_detalle is not { } actual || EmpresaSage.RucSesion is not { } ruc)
        {
            return;
        }

        var comentario = _comentarioRevision.Trim();
        if (comentario.Length == 0)
        {
            _errorRevision = "El comentario es obligatorio.";
            return;
        }

        _procesandoRevision = true;
        _errorRevision = null;
        try
        {
            var usuario = _usuarioActual ?? "desconocido";
            await Procesador.RevisarAsync(ruc, actual.Fila, comentario, usuario);
            ReemplazarFila(actual, new RevisionDeFila(comentario, usuario, DateTime.UtcNow, EstadoRevision.Revisada));
            _comentarioRevision = "";
        }
        catch (Exception ex)
        {
            _errorRevision = $"No se pudo guardar la revisión: {ex.Message}";
            Logger.LogError(ex, "Revisión de {Documento} ({Ruc})", actual.Documento, ruc);
        }
        finally
        {
            _procesandoRevision = false;
        }
    }

    private async Task QuitarRevision()
    {
        if (_detalle is not { } actual || EmpresaSage.RucSesion is not { } ruc)
        {
            return;
        }

        _procesandoRevision = true;
        _errorRevision = null;
        try
        {
            await Procesador.QuitarRevisionAsync(ruc, actual.Fila);
            ReemplazarFila(actual, null);
        }
        catch (Exception ex)
        {
            _errorRevision = $"No se pudo quitar la revisión: {ex.Message}";
            Logger.LogError(ex, "Quitar revisión de {Documento} ({Ruc})", actual.Documento, ruc);
        }
        finally
        {
            _procesandoRevision = false;
        }
    }

    // Actualiza la fila en memoria en vez de volver a conciliar (evita releer Sage completo por un comentario).
    private void ReemplazarFila(FilaConRevision anterior, RevisionDeFila? revision)
    {
        var nueva = anterior with { Revision = revision };
        var i = _filas?.IndexOf(anterior) ?? -1;
        if (i >= 0)
        {
            _filas![i] = nueva;
        }

        _detalle = nueva;
    }
}
